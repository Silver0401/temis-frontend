fillSpace()
    width: 100%
    height: 100%

alignStuff(l, c, r, up)
    display: flex
    justify-content: space-evenly

    if c 
        align-items: center
    else if r
        align-items: flex-end
    else if l
        align-items: flex-start
    else 
        align-items: center


    if up
        flex-direction: column
    else
        flex-direction: row


wrapContainers()
    display: flex
    flex-wrap: wrap

noScrollbar()
    scrollbar-width: none
    -ms-overflow-style: none
    &::-webkit-scrollbar
        display: none

overlappedContainers()
    @media (max-width: 1100px)

        #overlap1
            background-color: var(--transparency)
            top: 0
            left: 0
            position: absolute
            z-index: var(--globalZ3)
            fillSpace()

        #overlap2
            top: 0
            left: 0
            position: absolute
            z-index: var(--globalZ2)
            fillSpace()

