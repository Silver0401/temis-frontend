
.LegendCC
    position: relative
    background-color: var(--transparency)
    border-radius: 10px
    color: var(--white)
    padding: 10px 5px
    display: flex
    flex-direction: row
    font-family: "Poppins", sans-serif;
    font-size: 0.7rem

    p
        color: var(--primary)
        padding-right: 10px
        margin-left: 5px
        border-right: 2px solid var(--primary)

