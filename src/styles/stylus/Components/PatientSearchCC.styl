.GeneralSearchCCContainer
    position: relative
    fillSpace()
    display: flex
    flex-direction: column
    justify-content: center
    align-items: center

    h3
        position: relative
        padding-bottom: 40px
        color: var(--bg)

    .SearchInputContainer
        position: relative
        width: 100%
        display: flex
        align-items: center
        justify-content: center

        .Connectors
            position: absolute
            width: 100%
            height: 100%
            pointer-events: none

            .leftConnector
                position: absolute
                left: 0px
                top: 28px
                width: 6px
                height: 7px
                background-color: var(--silver)
                z-index : 2

            .leftConnector::after
                position: absolute
                content: ""
                left: 0px
                top: 0px
                width: 2px
                height: 100%
                background-color: var(--tertiary)
                
            .rightConnector
                position: absolute
                right: 0px
                top: 28px
                width: 6px
                height: 7px
                background-color: var(--silver)
                z-index : 2
        
            .rightConnector::after
                position: absolute
                content: ""
                right: 0px
                top: 0px
                width: 2px
                height: 100%
                background-color: var(--tertiary)


        .PatientDropdown
            position: absolute
            top: 33px
            left: 0
            width: 100%
            border: 2px solid var(--tertiary)
            border-top: 2px solid var(--silver)
            border-bottom-right-radius: 15px
            border-bottom-left-radius: 15px
            display: inline-block
            overflow-y: scroll
            overflow-x: hidden
            background-color: var(--silver)
            transition: height 350ms 
            box-shadow: 5px 5px 5px 1px var(--translucid)
            transform-origin: top

            .SearchedPatients, .RecentPatients
                position: relative
                height: auto
                display: grid
                place-items: center
                margin: 8px
                border-radius: 5px
                cursor: pointer

                .sectionTitle
                    border-radius: 10px
                    width: 100%
                    height: 40px
                    display: grid
                    place-items: center

                    p
                        font-size: 0.8rem
                        font-weight: 500

                .PatientOption
                    position: relative
                    font-size: 0.8rem
                    color: var(--white)
                    height 50px
                    border-bottom: 1px solid var(--grey)
                    display: flex
                    align-items: center
                    width: 100%
                    justify-content: flex-start
                    padding-left: 10px
                    transition: background-color 350ms

                    &:hover 
                        background-color: var(--transparency)



                #RecentTitle
                    background-color: var(--primary)
                    color: var(--bg)

                #SearchedTitle
                    background-color: var(--secondary)
                    color: var(--white)

        #listOpen
            height: 300px

        #listClosed
            height: 110px