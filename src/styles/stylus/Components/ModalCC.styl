.Modal-CC-Container
    top: 0
    left: 0
    z-index var(--globalZ5)
    position: fixed !important
    alignStuff(0,1,0,0)
    overflow-y: auto
    padding: 12px
    // Backdrop frosted glass (uniforme day/night)
    background: var(--translucid)

    .Modal-CC
        position: relative
        border-radius: 20px
        alignStuff(0,1,0,0)
        will-change: transform, opacity
        transform-origin: center
        backface-visibility: hidden
        max-width: calc(100vw - 24px)
        max-height: calc(100dvh - 24px)
        overflow-y: auto
        overscroll-behavior: contain
        // Glass panel
        background-image: var(--lp-glass-shine)
        border: 1px solid var(--lp-glass-border)
        box-shadow: 0 16px 48px var(--lp-featured-shadow)

        .xModalButton
            position: absolute
            top: 10px
            right: 10px
            width: 44px
            height: 44px
            cursor pointer
            z-index: var(--globalZ5)
            transition: color 0.2s var(--lp-ease)

            svg
                color: var(--white)

            &:hover svg
                color: var(--lp-accent)

    #bottomSlideMod
        position: absolute
        bottom: 0
        border-bottom-right-radius: 0px
        border-bottom-left-radius: 0px


    .fullModal-CC
        position: absolute
        fillSpace()
        will-change: opacity
        backface-visibility: hidden

        .xModalButton
            position: absolute
            top: 0px
            right: 20px
            width: 44px
            height: var(--nav)
            cursor pointer
            display: grid
            place-items: center
            transition: color 0.2s var(--lp-ease)

            svg
                color: var(--white)

            &:hover svg
                color: var(--lp-accent)


.Schema-day
    .Modal-CC, .fullModal-CC
        background-color: var(--lp-bg-mid-inverse)

.Schema-night
    .Modal-CC, .fullModal-CC
        background-color: var(--lp-bg-mid)
