.PrescriptionCC
    position: relative
    background-color: var(--bg)
    width: 300px
    height: 250px
    border-radius: 15px
    border: 1px solid var(--white)
    margin: 20px

    .title
        position: absolute
        left: 15px
        top: 10px
        color: var(--white)

    .date
        position: absolute
        right: 15px
        top: 15px
        font-size: 0.8rem
        color: var(--white)

    .drugContainer
        position: relative
        left: 10px
        top: 60px
        width: 60%
        height: auto
        alignStuff(0,1,0,1)

        .drugLine
            position: relative
            width: 100%
            padding: 5px 0px
            alignStuff(0,1,0,0)

            p
                color: var(--white)
                font-size: 0.8rem


    .buttonContainer
        position: absolute
        bottom: 0
        width: 100%
        height: 70px
        alignStuff(0,1,0,0)
