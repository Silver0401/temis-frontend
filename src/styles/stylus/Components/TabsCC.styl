.TabsCC
    position: relative
    width: 300px
    height: 100%

    .TabCC
        width: 90%
        margin: 0px auto
        height: 50px
        border-bottom: 1px solid gray
        alignStuff(0,1,0,0)
        cursor: pointer
        border-radius: 10px

        p
            font-size: 0.8rem
            color: var(--bg)

    .activeCC
        background-color: var(--primary)

        p
            color: var(--bg)
