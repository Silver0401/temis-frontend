.OrderCC
    position: relative
    background-color: var(--bg)
    width: min(100%, 300px)
    height: 250px
    border-radius: 15px
    border: 1px solid var(--white)
    margin: 20px

    .title
        position: absolute
        left: 15px
        top: 10px

    .date
        position: absolute
        right: 15px
        top: 15px
        font-size: 0.8rem

    .orderContainer
        position: relative
        left: 10px
        top: 60px
        width: 60%
        height: auto
        alignStuff(0,1,0,1)

        .orderLine
            position: relative
            width: 100%
            padding: 5px 0px
            alignStuff(0,1,0,0)

            p
                font-size: 0.8rem


    .buttonContainer
        position: absolute
        bottom: 0
        width: 100%
        height: 70px
        alignStuff(0,1,0,0)

@media (max-width: 800px)
    .OrderCC
        margin-inline: 0
