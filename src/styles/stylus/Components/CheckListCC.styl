.CheckListCC
    position: relative
    width: 100%
    display: inline-block
    overflow: hidden

    h3
        position: relative
        font-size: 1.1rem
        width: 100%
        height: 50px
        color: var(--primary)
        border: 1px solid var(--white)
        border-radius: 10px
        alignStuff(0,1,0,0)
        justify-content: flex-start
        padding-left: 25px
        cursor pointer

    .CheckListContainer
        position: relative
        width: 100%
        height: auto

        .CheckListItem, .NoItemsInfo
            position: relative
            alignStuff(0,1,0,0)
            width: 100%
            height: 70px
            padding-left: 15px
            border-bottom: 1px solid var(--lightgrey)
            color: var(--white)
            font-size: 0.8rem

    .ArrowContainer
        position: absolute
        right: 25px
        top: 15px
        width: 20px
        height: 20px
        transition: transform 200ms
        color: var(--white)

    #UpArrow
        transform: rotate(0deg)

    #DownArrow
        transform: rotate(180deg)

#OpenCheckList
    height: auto

#ClosedCheckList
    height: 50px


.CheckList-day
    h3
        color: var(--primary)
        border: 1px solid var(--white)

    .CheckListContainer
        .CheckListItem, .NoItemsInfo
            border-bottom: 1px solid var(--grey)
            color: var(--white)

    .ArrowContainer
        color: var(--white)


.CheckList-night
    h3
        color: var(--secondary) !important
        border: 1px solid var(--bg) !important

    .CheckListContainer
        .CheckListItem, .NoItemsInfo
            border-bottom: 1px solid var(--silver) !important
            color: var(--bg) !important

    .ArrowContainer
        color: var(--bg) !important