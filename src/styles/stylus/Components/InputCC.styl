@keyframes rotate {
    from {
        transform: rotate(0deg)
    }
    to {
        transform: rotate(360deg)
    }
}

.InputCC-Container
    position: relative
    min-height: 44px
    alignStuff(0,1,0,0)
    width: 180px
    border-radius: 7px
    border: 2px solid transparent;
    background-color: var(--lp-bg-mid-inverse)

    .placeholderHider
        position: absolute
        width: 100%
        height: 100%
        z-index: 1
        pointer-events: none
        opacity: 1
        background-color: var(--lp-bg-mid-inverse)

    label
        position: absolute
        width: auto
        left: 10px
        font-size: 0.8rem
        transition: transform 350ms
        pointer-events: none
        padding: 5px 15px
        background-color: var(--lp-bg-mid-inverse)
        transition: transform 350ms, color 300ms, background-color 1000ms
        color: var(--bg)
        z-index: 2

    

    &:focus-within 
        border: 2px solid var(--tertiary);


    .InputCC
        position: absolute
        width: 98%
        height: 100%
        border-radius: 7px
        padding-left: 10px
        outline: none
        border: none
        transition: background-color 250ms;
        cursor pointer
        font-family: "Poppins", sans-serif;
        z-index: 1
        font-size: 16px


    .InputCC
        background-color: transparent
        color: var(--bg)

        &::placeholder
            color: var(--silver) 

    .InputCC:-webkit-autofill,
    .InputCC:-webkit-autofill:hover, 
    .InputCC:-webkit-autofill:focus, 
    .InputCC:-webkit-autofill:active{
        -webkit-box-shadow: 0 0 0 30px var(--grey) inset 
        -webkit-text-fill-color: var(--dual) 
    }

    // .InputCC-Select

        
    .InputCCTypefile
        border: 4px solid green
        opacity: 0

    .InputCCTypedisabled
        color: var(--silver) !important
        cursor: not-allowed 

    .InputCCTypedate
        padding-right: 5px

    .InputCCTypenumber::-webkit-outer-spin-button,
    .InputCCTypenumber::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

    .InputCCTypenumber[type="number"] 
            -moz-appearance: textfield;


    &:hover
        .filesContainer
            opacity: 1
            transition: opacity 250ms 

    .filesContainer
        position: relative
        fillSpace(0,1,0,0)
        alignStuff(0,1,0,0)
        border-radius: 10px
        opacity: 0.7
        transition: opacity 250ms 
        overflow-x: auto
        z-index: 1

        .innerFilesContainer
            z-index: 5
            position: relative
            display: inline-flex
            flex-direction: row
            width: auto
            height: 100%

            .fileDiv
                position: relative
                width: 120px
                height: 90%
                margin: 10px
                background-color: var(--bg)
                border-radius: 10px
                alignStuff(0,1,0,0)
                color: var(--white)

                .xButton
                    position: absolute
                    top: -5px
                    right: -5px
                    width: 44px
                    height: 44px
                    background-color: var(--red)
                    border-radius: 50%
                    cursor: pointer
                    display: grid
                    place-items: center
                    opacity: 0.6
                    transition: opacity 300ms

                    &:hover
                        opacity: 1
                        transition: opacity 300ms

                    svg
                        position: relative
                        width: 80%
                        height: 80%
                        color: var(--bg)

                p
                    font-size: 0.7rem
                    margin: 0px 5px
                    text-align: center

        .defaultContainer
            position: relative
            alignStuff(0,1,0,0)
            fillSpace()

            p
                position: relative
                color: #bbf3d8
                text-align: center
                margin: 0px 15px

    .inputQrCodeButton
        position: absolute !important
        top: 10px !important
        left: 10px !important
        z-index: 6 !important



    .InputCC-Icon
        position: absolute !important
        right: 2px
        overflow: hidden
        width: 44px
        height: 44px
        alignStuff(0,1,0,0)
        border-radius: 5px
        z-index: 4
        border: 1px solid var(--white)
        background-color: var(--bg)

        .closedLock
            fill: var(--red)

        .openLock
            fill: var(--green)

        .loadingInputIcon
            animation: rotate 2s linear infinite

        svg
            color: var(--primary)
            cursor: pointer
            width: 60%
            height: 60%
            fill: var(--primary)

        .closedLock
            fill: var(--red)

        .openLock
            fill: var(--green)

        .CorrectCheck
            fill: var(--green)
            width: 17px
            height: 17px

        .ErrorCross
            fill: var(--red)
            width: 17px
            height: 17px

    
    .InputCCIconTypedate
        pointer-events: none    

    .InputCCIconTypedisabled
        svg
            color: var(--red) !important

    .InputCC-Suggestion
        position: absolute
        bottom: calc(100% + 5px)
        right: 0
        display: flex
        align-items: center
        gap: 5px
        cursor: pointer
        padding: 3px 9px
        border-radius: 20px
        background-color: rgba(136, 226, 138, 0.1)
        border: 1px solid rgba(136, 226, 138, 0.3)
        transition: background-color 200ms
        width: fit-content
        z-index: 10

        &:hover
            background-color: rgba(136, 226, 138, 0.22)
            transition: background-color 200ms

        svg
            width: 14px
            height: 14px
            fill: var(--green)
            flex-shrink: 0

        span
            font-size: 0.72rem
            color: var(--white)
            white-space: nowrap
            overflow: hidden
            text-overflow: ellipsis
            max-width: 160px



