.InputCC-Checkbox
    position: relative
    min-height: 44px
    width: 180px
    alignStuff(0,1,0,0)
    justify-content: flex-start
    cursor: pointer
    cursor: pointer

    .InputCC
        width: 40px
        height: 20px

    label
        margin-left: 15px
        color: var(--white)
        pointer-events: none
        user-select: none
        font-size: 0.9rem

        .InputCC-CheckboxLink-Text
            margin-left: 4px
            color: var(--primary)
            text-decoration: underline
            cursor: pointer
            pointer-events: all
            transition: opacity 200ms

            &:hover
                opacity: 0.7
                transition: opacity 200ms

.InputCCTypecheckBoxLink
    width: 40px
    height: 20px

.InputCC-Textarea
    resize: none
    fillSpace()
    padding: 10px
    font-size: 16px

// type="custom": wrapper only holds children (e.g. AfiliacionesCheckGroup).
// Drop the generic input box (fixed 35px, 180px, grey bg) so children set the
// size — otherwise a grey input shows behind and the box overlaps the field below.
.InputCC-Container.InputCC-Custom
    height: auto
    width: 100%
    background-color: transparent
    border: none
    display: block

    &:focus-within
        border: none

.InputCC-Container[data-direction="horizontal"]
    flex-direction: row
    align-items: center
    width: auto
    min-width: 105px
    max-width: 155px
    min-height: 44px
    padding: 0 8px
    border-radius: 7px

    .placeholderHider
        display: none

    label
        position: static
        background: transparent !important
        font-size: 0.72rem
        padding: 0
        padding-right: 5px
        white-space: nowrap
        color: var(--white)
        transform: none !important
        transition: none !important
        z-index: 0

    .InputCC
        position: static
        flex: 1
        min-width: 40px
        height: 100%
        padding-left: 4px
        text-align: center
        font-size: 16px
        width: auto

    .InputCC-Icon
        display: none


#InputCC-Selected
    label
        transition: transform 350ms, color 300ms, background-color 100ms
        color: var(--white) !important
        transform: translate(-15px, -27px)
        background-color: transparent !important 

    .placeholderHider
        opacity: 0
        transition: opacity 350ms

#InputCC-Selected-day
    label
        transition: transform 350ms, color 300ms, background-color 100ms
        color: var(--white) !important
        transform: translate(-15px, -27px)
        background-color: transparent !important 

    .placeholderHider
        opacity: 0
        transition: opacity 350ms

#InputCC-Selected-night
    label
        transition: transform 350ms, color 300ms, background-color 100ms
        color: var(--bg) !important
        transform: translate(-15px, -27px)
        background-color: transparent !important 

    .placeholderHider
        opacity: 0
        transition: opacity 350ms

.InputCC-Container[data-validation="valid"]
    border-color: var(--green) !important
    transition: border-color 200ms

.InputCC-Container[data-validation="error"]
    border-color: var(--red) !important
    transition: border-color 200ms

.fakeHideInputCC
    height: 0px
    visibility: hidden
    position: absolute
    pointer-events: none

.InputCC-PasswordStrength
    position: absolute
    right: 30px
    top: 50%
    transform: translateY(-50%)
    display: flex
    align-items: center
    gap: 5px
    z-index: 3

    .InputCC-PasswordStrength-Dot
        width: 9px
        height: 9px
        border-radius: 50%
        flex-shrink: 0
        background-color: rgba(255,255,255,0.08)
        border: 1.5px solid rgba(255,255,255,0.13)
        transition: all 0.4s ease

        &:nth-child(1)[data-active="true"]
            background-color: var(--red-inverted)
            border-color: var(--red-inverted)
            box-shadow: 0 0 7px 2px rgba(238,158,158,0.44), inset 0 0 3px rgba(238,158,158,0.25)

        &:nth-child(2)[data-active="true"]
            background-color: var(--yellow-inverted)
            border-color: var(--yellow-inverted)
            box-shadow: 0 0 7px 2px rgba(244,235,106,0.44), inset 0 0 3px rgba(244,235,106,0.25)

        &:nth-child(3)[data-active="true"]
            background-color: var(--green-inverted)
            border-color: var(--green-inverted)
            box-shadow: 0 0 7px 2px rgba(136,226,138,0.44), inset 0 0 3px rgba(136,226,138,0.25)

    .InputCC-PasswordStrength-Divider
        width: 1px
        height: 12px
        background-color: rgba(255,255,255,0.1)
        border-radius: 1px
        flex-shrink: 0

    .InputCC-PasswordStrength-Label
        margin: 0
        font-size: 9px
        font-weight: 700
        letter-spacing: 0.07em
        text-transform: uppercase
        transition: all 0.4s ease

    &[data-level="1"] .InputCC-PasswordStrength-Label
        color: var(--red-inverted)
        text-shadow: 0 0 8px rgba(238,158,158,0.56)

    &[data-level="2"] .InputCC-PasswordStrength-Label
        color: var(--yellow-inverted)
        text-shadow: 0 0 8px rgba(244,235,106,0.56)

    &[data-level="3"] .InputCC-PasswordStrength-Label
        color: var(--green-inverted)
        text-shadow: 0 0 8px rgba(136,226,138,0.56)

// ── Icon tooltip (hover over the input icon) ────────────────────────────────
// The icon clips its overflow; reveal it on hover so the tooltip can escape.
.InputCC-Icon
    &:hover
        overflow: visible

    .InputCC-IconTooltip
        // Always above the icon; body grows inward (left, into the input) so it
        // never spills past the input's right edge.
        position: absolute
        bottom: calc(100% + 8px)
        right: 0
        left: auto
        min-width: 160px
        max-width: 240px
        display: none
        flex-direction: column
        gap: 3px
        padding: 8px 10px
        border-radius: 8px
        background-color: var(--white)
        color: var(--bg)
        font-size: 0.72rem
        line-height: 1.2
        text-align: left
        box-shadow: 5px 5px 5px 1px var(--translucid)
        z-index: 20
        pointer-events: none
        white-space: normal

        span
            display: block

        // Arrow sits at the tooltip's right, pointing down to the icon.
        &::after
            content: ""
            position: absolute
            top: 100%
            right: 8px
            border: 6px solid transparent
            border-top-color: var(--tertiary)

    &:hover .InputCC-IconTooltip
        display: flex
