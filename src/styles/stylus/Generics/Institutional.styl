// ═══════════════════════════════════════════════════════════════════════════════
// INSTITUTIONAL PAGES — Nosotros, Contacto, Legal
// ═══════════════════════════════════════════════════════════════════════════════

.lp-institutional
  padding-top calc(var(--nav) + clamp(48px, 8vw, 96px))
  padding-bottom clamp(80px, 10vw, 140px)
  min-height 80vh

.lp-inst-hero
  max-width 860px
  margin-bottom clamp(48px, 6vw, 80px)

.lp-inst-title
  font-size clamp(28px, 5vw, 52px)
  font-weight 700
  line-height 1.1
  letter-spacing -0.02em
  color var(--lp-text-1)
  margin 16px 0 20px

  em
    font-style normal
    color var(--primary)

.lp-inst-sub
  font-size clamp(15px, 1.8vw, 18px)
  font-weight 300
  color var(--lp-text-2)
  line-height 1.8
  max-width 760px

// ── Sections (Nosotros) ──────────────────────────────────────────────────────

.lp-inst-section
  border-top 1px solid var(--lp-glass-border)
  padding clamp(28px, 4vw, 44px) 0
  max-width 680px

.lp-inst-h2
  font-size 11px
  font-weight 500
  letter-spacing 0.2em
  text-transform uppercase
  color var(--primary)
  margin-bottom 14px

.lp-inst-body
  font-size 15px
  font-weight 300
  color var(--lp-text-2)
  line-height 1.85

.lp-inst-cta
  display inline-flex
  align-items center
  gap 8px
  margin-top clamp(28px, 4vw, 44px)
  font-size 14px
  font-weight 500
  color var(--primary)
  text-decoration none
  border-bottom 1px solid var(--lp-glass-border-hi)
  padding-bottom 3px
  transition color 0.2s, border-color 0.2s, gap 0.2s

  &:hover
    color var(--secondary)
    border-color var(--secondary)
    gap 14px

// ── Contact cards (Contacto) ─────────────────────────────────────────────────

.lp-inst-contact-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(240px, 1fr))
  gap 20px
  margin-top clamp(32px, 4vw, 48px)

.lp-inst-contact-item
  position relative
  background var(--lp-glass-bg)
  border 1px solid var(--lp-glass-border)
  border-radius 16px
  padding 28px 32px
  text-decoration none
  display flex
  flex-direction column
  gap 6px
  overflow hidden
  transition border-color 0.25s, transform 0.25s

  &::before
    content ""
    position absolute
    inset 0
    background radial-gradient(ellipse at top left, var(--lp-accent-soft) 0%, transparent 65%)
    opacity 0
    transition opacity 0.3s

  &:hover
    border-color var(--lp-glass-border-hi)
    transform translateY(-3px)

    &::before
      opacity 1

    .lp-inst-contact-arrow
      opacity 1
      transform translateX(0)

.lp-inst-contact-label
  font-size 11px
  font-weight 500
  letter-spacing 0.16em
  text-transform uppercase
  color var(--lp-text-3)
  margin 0

.lp-inst-contact-value
  font-size 15px
  font-weight 500
  color var(--primary)
  margin 0
  transition color 0.2s

.lp-inst-contact-desc
  font-size 13px
  font-weight 300
  color var(--lp-text-2)
  line-height 1.6
  margin 4px 0 0

.lp-inst-contact-arrow
  position absolute
  bottom 24px
  right 28px
  font-size 18px
  color var(--primary)
  opacity 0
  transform translateX(-6px)
  transition opacity 0.2s, transform 0.2s

// ── Legal pages ──────────────────────────────────────────────────────────────

.lp-legal .lp-inst-hero
  max-width 560px

.lp-legal-body
  border-top 1px solid var(--lp-glass-border)
  padding-top clamp(32px, 4vw, 48px)
  max-width 720px

.lp-legal-placeholder
  color var(--lp-text-3) !important
  font-style italic

// ── Specialty pages ──────────────────────────────────────────────────────────

.lp-specialty
  position relative
  overflow hidden

.lp-sp-watermark
  position absolute
  top clamp(60px, 8vw, 100px)
  right clamp(-120px, -6vw, -40px)
  width clamp(320px, 38vw, 500px)
  height clamp(320px, 38vw, 500px)
  pointer-events none
  opacity 0.09
  filter unquote("drop-shadow(0 0 20px color-mix(in srgb, var(--sp-accent) 90%, transparent)) drop-shadow(0 0 70px color-mix(in srgb, var(--sp-accent) 55%, transparent)) drop-shadow(0 0 140px color-mix(in srgb, var(--sp-accent) 28%, transparent))")

  svg
    width 100%
    height 100%
    fill unquote("color-mix(in srgb, var(--white) 35%, var(--white))")

  svg path, svg circle, svg rect, svg line, svg polyline, svg polygon, svg ellipse
    fill unquote("color-mix(in srgb, var(--white) 35%, var(--white))")

.lp-sp-inst-icon
  display flex
  align-items center
  justify-content center
  width 72px
  height 72px
  border-radius 50%
  border 1.5px solid unquote("color-mix(in srgb, var(--sp-accent) 50%, transparent)")
  background unquote("color-mix(in srgb, var(--sp-accent) 12%, var(--lp-card-bg))")
  box-shadow unquote("0 0 32px color-mix(in srgb, var(--sp-accent) 25%, transparent)")
  color var(--sp-accent)
  margin-bottom 20px
  filter unquote("drop-shadow(0 0 10px color-mix(in srgb, var(--sp-accent) 60%, transparent))")

  svg
    width 32px
    height 32px
    fill var(--sp-accent)

  svg path, svg circle, svg rect, svg line, svg polyline, svg polygon
    fill var(--sp-accent)

.lp-inst-title--accent
  background unquote("linear-gradient(120deg, var(--lp-text-1) 40%, var(--sp-accent))")
  -webkit-background-clip text
  background-clip text
  -webkit-text-fill-color transparent
  color transparent

.lp-sp-bullet-ico--accent
  color unquote("color-mix(in srgb, var(--sp-accent) 80%, var(--lp-text-2))")

// ── Responsive ───────────────────────────────────────────────────────────────

@media (max-width: 640px)
  .lp-institutional
    padding-top calc(var(--nav) + 32px)

  .lp-inst-contact-grid
    grid-template-columns 1fr

  .lp-legal-body
    overflow-wrap anywhere
