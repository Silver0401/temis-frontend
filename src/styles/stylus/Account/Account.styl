@keyframes levitate{
    0%{
        transform: translate(0,0) rotate(0deg)
    }
    25%{
        transform: translate(30px,-50px)
    }
    50%{
        transform: translate(12px,-35px)
    }
    75%{
        transform: translate(23px,-40px)
    }
    100%{
        transform: translate(0,0px) rotate(360deg)
    }
}

.AccountSection
    position: relative

    .innerAccountContainer
        alignStuff(0,1,0,0)
        position: relative
        width: 100%
        height: 100%
        overlappedContainers()
    
        .LogRegisterSection, .NewsSection, .ProfileSection
            position: relative
            flex: 1 1 500px
            overflow: hidden
            width: 50%
            height: 100%

        .LogRegisterSection
            alignStuff(0,1,0,0)

            .LogRegisterFormContainer
                position: relative
                width: 70%
                height: 70%

                .logoMiniGradient
                    position: absolute !important
                    right: -10px
                    top: -70px
                    width: 60px
                    height: 60px
                    border-radius: 20px
                    background: linear-gradient(-45deg, #6fb986, var(--secondary), var(--primary)) 
                    alignStuff(0,1,0,0)
                    overflow: hidden
                    justify-content: center

                    img
                        width: 80%
                        height: 80%

                .inlineLogRegister
                    width: 100%
                    height: 35px
                    alignStuff(0,1,0,0)
                    justify-content: flex-start
                    cursor: pointer

                    svg
                        position: relative
                        width: 20px
                        height: 20px
                        margin-left: 5px
                        fill: var(--primary)
                        transform: translateX(0px)
                        transition: 350ms transform

                    p:nth-child(1)
                        color: var(--white)

                    p:nth-child(2)
                        margin-left: 10px
                        color: var(--primary)
                        font-weight: 500

                    &:hover
                        svg
                            transform: translateX(5px)
                            transition: 350ms transform


        .NewsSection
            alignStuff(0,1,0,0)

            span
                position: absolute
                background-color: rgba(255, 255, 255, 0.3)
                backdrop-filter: blur(5px)
                border-radius: 8px
                border: 1px solid rgba(255, 255, 255, 0.6)
                // Los cuadros flotan encima del lienzo; si capturan el puntero
                // el efecto de desintegración se corta al pasar sobre ellos.
                pointer-events: none

            .square1
                animation: levitate 30s linear infinite
                animation-delay: 2s
                width: 50px
                height: 90px
                top: 95px
                left: 135px
            .square2
                animation: levitate 23s linear infinite
                animation-delay: 1s
                width: 150px
                height: 40px
                top: 500px
                left: 100px
            .square3
                animation: levitate 50s linear infinite
                animation-delay: 4s
                width: 70px
                height: 120px
                bottom: 400px
                right: 150px
            .square4
                animation: levitate 36 linear infinite
                animation-delay: 3s
                width: 90px
                height: 90px
                bottom: 80px
                right: 140px


            // Lienzo a sangre: ocupa todo el lado derecho, sin margen ni
            // esquinas redondeadas. La imagen ya no va por background-image
            // porque la dibuja DisintegrateImage sobre un <canvas>.
            .bgImgContainer
                position: absolute
                inset: 0
                width: 100%
                height: 100%
                display: block
                touch-action: none
                
        .ProfileSection
            fillSpace()
            display: flex
            flex-direction: row
            overflow: hidden

            .ProfileLeftPanel
                width: 280px
                min-width: 240px
                height: 100%
                overflow-y: auto
                border-right: 1px solid var(--silver)
                padding: 30px 20px
                display: flex
                flex-direction: column
                align-items: center
                gap: 12px

                .ProfileAvatar
                    width: 90px
                    height: 90px
                    border-radius: 50%
                    background: linear-gradient(-45deg, var(--secondary), var(--primary))
                    display: flex
                    align-items: center
                    justify-content: center
                    overflow: hidden
                    flex-shrink: 0

                    img
                        width: 100%
                        height: 100%
                        object-fit: cover

                    span
                        font-size: 2rem
                        font-weight: 700
                        color: var(--bg)

                .ProfileUniqueIdentifier
                    width: 100%
                    color: var(--white)
                    font-size: 0.6rem
                    text-align: center
                    height: 16px

                .ProfileName
                    font-size: 1rem
                    color: var(--white)
                    text-align: center
                    font-weight: 600

                .ProfileProfessionBadge
                    background: var(--secondary)
                    color: var(--primary)
                    padding: 4px 12px
                    border-radius: 20px
                    font-size: 0.7rem
                    font-weight: 600
                    text-align: center

                .ProfileClues
                    font-size: 0.75rem
                    color: var(--grey)
                    text-align: center

                    strong
                        color: var(--white)

                .ProfileInstitute
                    font-size: 0.75rem
                    color: var(--grey)
                    text-align: center

                    span
                        display: block
                        margin-top: 2px

                .ProfileDivider
                    width: 80%
                    height: 1px
                    background: var(--silver)
                    margin: 8px 0

                .ProfileStats
                    display: flex
                    gap: 24px

                    .ProfileStat
                        display: flex
                        flex-direction: column
                        align-items: center

                        strong
                            font-size: 1.5rem
                            color: var(--primary)
                            font-weight: 700

                        span
                            font-size: 0.7rem
                            color: var(--grey)

                .ProfileLogoutContainer
                    margin-top: auto
                    width: 100%
                    padding-top: 20px

            .ProfileRightPanel
                flex: 1
                height: 100%
                overflow-y: auto
                padding: 30px 24px
                display: flex
                flex-direction: column
                gap: 16px

                .ProfileCard
                    border: 1px solid var(--silver)
                    border-radius: 12px
                    padding: 20px

                    .ProfileCardTitle
                        font-size: 0.7rem
                        color: var(--grey)
                        text-transform: uppercase
                        letter-spacing: 0.08em
                        margin-bottom: 16px
                        font-weight: 600

                    .ProfileCardGrid
                        display: grid
                        grid-template-columns: repeat(2, 1fr)
                        gap: 16px

                    .ProfileField
                        display: flex
                        flex-direction: column
                        gap: 4px

                        label
                            font-size: 0.65rem
                            color: var(--grey)
                            text-transform: uppercase
                            letter-spacing: 0.05em

                        p
                            font-size: 0.9rem
                            color: var(--white)

                        .ProfileFieldMono
                            font-family: monospace
                            font-size: 0.85rem
                            letter-spacing: 0.04em

                    .ProfileEmptyState
                        color: var(--grey)
                        font-size: 0.85rem
                        text-align: center
                        padding: 20px 0

                    .ProfileLicenseList
                        display: flex
                        flex-direction: column
                        gap: 8px

                        .ProfileLicenseItem
                            display: flex
                            align-items: center
                            gap: 16px
                            padding: 12px 16px
                            background: var(--silver)
                            border-radius: 8px

                            .ProfileLicenseId
                                font-size: 0.95rem
                                font-weight: 700
                                color: var(--primary)
                                font-family: monospace
                                min-width: 80px

                            .ProfileLicenseDetails
                                display: flex
                                flex-direction: column
                                flex: 1

                                span:first-child
                                    font-size: 0.85rem
                                    color: var(--white)
                                    font-weight: 500

                                span:last-child
                                    font-size: 0.75rem
                                    color: var(--grey)

                            .ProfileLicenseYear
                                font-size: 0.75rem
                                color: var(--grey)

                    .ProfileIdVerification
                        display: flex
                        gap: 20px
                        align-items: flex-start

                        .ProfileIdInfo
                            flex: 1

                        .ProfileIdPhoto
                            width: 80px
                            height: 80px
                            border-radius: 8px
                            overflow: hidden
                            flex-shrink: 0

                            img
                                width: 100%
                                height: 100%
                                object-fit: cover

                    .ProfileValidityBadge
                        display: inline-block
                        padding: 4px 12px
                        border-radius: 20px
                        font-size: 0.75rem
                        font-weight: 600

                        &[data-valid="true"]
                            background: var(--green-inverted)
                            color: var(--green)

                        &[data-valid="false"]
                            background: var(--yellow-inverted)
                            color: var(--yellow)

        


    
@media (max-width: 800px)
    .AccountSection
        .innerAccountContainer
            height: 800px

            .LogRegisterSection
                transform: translate(0%, 0%)

            .NewsSection
                transform: translate(0%, 0%)
                .bgImgContainer
                    background-size: 100% 120% !important

            .ProfileSection
                flex-direction: column

                .ProfileLeftPanel
                    width: 100%
                    height: auto
                    border-right: none
                    border-bottom: 1px solid var(--silver)
                    padding: 20px
                    flex-direction: row
                    flex-wrap: wrap
                    justify-content: center

                    .ProfileLogoutContainer
                        margin-top: 0
                        width: auto

                .ProfileRightPanel
                    padding: 20px 16px

                    .ProfileCard
                        .ProfileCardGrid
                            grid-template-columns: 1fr

