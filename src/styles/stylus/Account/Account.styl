@keyframes levitate{
    0%{
        transform: translate(0,0) rotate(0deg)
    }
    25%{
        transform: translate(30px,-50px)
    }
    50%{
        transform: translate(12px,-35px)
    }
    75%{
        transform: translate(23px,-40px)
    }
    100%{
        transform: translate(0,0px) rotate(360deg)
    }
}

.AccountSection
    position: relative

    .innerAccountContainer
        alignStuff(0,1,0,0)
        position: relative
        width: 100%
        height: 100%
        overlappedContainers()
    
        .LogRegisterSection, .NewsSection, .ProfileSection
            position: relative
            flex: 1 1 500px
            overflow: hidden
            width: 50%
            height: 100%

        .LogRegisterSection
            alignStuff(0,1,0,0)

            .LogRegisterFormContainer
                position: relative
                width: 70%
                height: 70%

                .logoMiniGradient
                    position: absolute !important
                    right: -10px
                    top: -70px
                    width: 60px
                    height: 60px
                    border-radius: 20px
                    background: linear-gradient(-45deg, #6fb986, var(--secondary), var(--primary)) 
                    alignStuff(0,1,0,0)
                    overflow: hidden
                    justify-content: center

                    img
                        width: 80%
                        height: 80%

                .inlineLogRegister
                    width: 100%
                    height: 35px
                    alignStuff(0,1,0,0)
                    justify-content: flex-start
                    cursor: pointer

                    svg
                        position: relative
                        width: 20px
                        height: 20px
                        margin-left: 5px
                        fill: var(--primary)
                        transform: translateX(0px)
                        transition: 350ms transform

                    p:nth-child(1)
                        color: var(--white)

                    p:nth-child(2)
                        margin-left: 10px
                        color: var(--primary)
                        font-weight: 500

                    &:hover
                        svg
                            transform: translateX(5px)
                            transition: 350ms transform


        .NewsSection
            alignStuff(0,1,0,0)

            span
                position: absolute
                background-color: rgba(255, 255, 255, 0.3)
                backdrop-filter: blur(5px)
                border-radius: 8px
                border: 1px solid rgba(255, 255, 255, 0.6)
                // Los cuadros flotan encima del lienzo; si capturan el puntero
                // el efecto de desintegración se corta al pasar sobre ellos.
                pointer-events: none

            .square1
                animation: levitate 30s linear infinite
                animation-delay: 2s
                width: 50px
                height: 90px
                top: 95px
                left: 135px
            .square2
                animation: levitate 23s linear infinite
                animation-delay: 1s
                width: 150px
                height: 40px
                top: 500px
                left: 100px
            .square3
                animation: levitate 50s linear infinite
                animation-delay: 4s
                width: 70px
                height: 120px
                bottom: 400px
                right: 150px
            .square4
                animation: levitate 36 linear infinite
                animation-delay: 3s
                width: 90px
                height: 90px
                bottom: 80px
                right: 140px


            // Lienzo a sangre: ocupa todo el lado derecho, sin margen ni
            // esquinas redondeadas. La imagen ya no va por background-image
            // porque la dibuja DisintegrateImage sobre un <canvas>.
            .bgImgContainer
                position: absolute
                inset: 0
                width: 100%
                height: 100%
                display: block
                touch-action: none
                
        .ProfileSection
            fillSpace()
            position: relative
            overflow-y: auto
            overflow-x: hidden
            noScrollbar()
            display: block
            padding: 0 clamp(20px, 4vw, 58px) 70px

            .ProfileHeading
                padding: 42px 0 28px
                display: flex
                align-items: flex-end
                justify-content: space-between
                gap: 28px

                .ProfileHeadingCopy
                    min-width: 0

                    .ProfileEyebrow
                        margin: 0 0 8px
                        color: var(--lp-accent)
                        font-size: 0.67rem
                        font-weight: 800
                        letter-spacing: 0.17em
                        text-transform: uppercase

                    h1
                        margin: 0
                        font-family: var(--font)
                        font-size: clamp(2.2rem, 5vw, 4.6rem)
                        font-weight: 400
                        line-height: 0.92
                        letter-spacing: -0.02em
                        color: var(--lp-text-1)

                    .ProfileHeadingSub
                        max-width: 560px
                        margin: 12px 0 0
                        color: var(--lp-text-2)
                        font-size: 0.84rem
                        line-height: 1.6

                .ProfileHeadingActions
                    display: flex
                    align-items: center
                    flex-wrap: wrap
                    justify-content: flex-end
                    gap: 9px

                    .ProfileUniqueIdentifier
                        padding: 8px 11px
                        border: 1px solid var(--lp-glass-border)
                        border-radius: 9px
                        color: var(--lp-text-2)
                        background: unquote("color-mix(in srgb, var(--lp-text-1) 3%, transparent)")
                        font-family: Menlo, Monaco, Consolas, monospace
                        font-size: 0.64rem
                        white-space: nowrap

            .ProfileLayout
                display: grid
                grid-template-columns: 300px minmax(0, 1fr)
                gap: 19px
                align-items: start

            .ProfileLeftPanel
                position: sticky
                top: 18px
                overflow: hidden
                border: 1px solid var(--lp-glass-border)
                border-radius: 22px
                background: var(--lp-glass-bg)
                box-shadow: unquote("inset 0 1px color-mix(in srgb, var(--lp-text-1) 4%, transparent), 0 20px 55px rgba(0, 0, 0, 0.18)")

                .ProfileCover
                    position: relative
                    height: 102px
                    background: unquote("linear-gradient(120deg, color-mix(in srgb, var(--lp-accent) 22%, transparent), color-mix(in srgb, var(--lp-accent-2) 34%, transparent))")

                    &::after
                        content: attr(data-initials)
                        position: absolute
                        right: -12px
                        bottom: -28px
                        font-family: var(--font)
                        font-size: 7rem
                        line-height: 0.8
                        color: unquote("color-mix(in srgb, var(--lp-text-1) 6%, transparent)")

                .ProfileIdentityBody
                    padding: 0 22px 22px
                    text-align: center

                .ProfileAvatar
                    position: relative
                    width: 92px
                    height: 92px
                    margin: -48px auto 16px
                    display: grid
                    place-items: center
                    border: 6px solid var(--lp-bg-mid)
                    border-radius: 50%
                    color: var(--bg)
                    background: linear-gradient(145deg, var(--lp-accent), var(--lp-accent-2))
                    font-family: var(--font)
                    font-size: 1.5rem

                    img
                        width: 100%
                        height: 100%
                        border-radius: 50%
                        object-fit: cover

                    .ProfileVerifiedMark
                        position: absolute
                        right: -2px
                        bottom: 2px
                        width: 25px
                        height: 25px
                        display: grid
                        place-items: center
                        border: 4px solid var(--lp-bg-mid)
                        border-radius: 50%
                        color: var(--bg)
                        background: var(--green)
                        font-family: "Poppins", sans-serif
                        font-size: 0.63rem
                        font-weight: 900

                .ProfileName
                    margin: 0
                    font-size: 1.08rem
                    font-weight: 600
                    line-height: 1.35
                    color: var(--lp-text-1)

                .ProfileProfessionBadge
                    display: block
                    width: fit-content
                    margin: 9px auto 0
                    padding: 5px 10px
                    border-radius: var(--lp-r-pill)
                    color: var(--lp-accent)
                    background: unquote("color-mix(in srgb, var(--lp-accent) 12%, transparent)")
                    font-size: 0.66rem
                    font-weight: 800

                .ProfileInstitute
                    margin: 17px 0 0
                    color: var(--lp-text-2)
                    font-size: 0.73rem
                    line-height: 1.55

                    strong
                        display: block
                        color: var(--lp-text-1)
                        font-size: 0.76rem

                .ProfileClues
                    margin: 12px 0 0
                    color: var(--lp-text-3)
                    font-family: Menlo, Monaco, Consolas, monospace
                    font-size: 0.62rem

                .ProfileStats
                    margin: 22px 0
                    padding: 18px 0
                    display: grid
                    grid-template-columns: 1fr 1fr
                    border-top: 1px solid var(--lp-glass-border)
                    border-bottom: 1px solid var(--lp-glass-border)

                    .ProfileStat
                        min-width: 0

                        & + .ProfileStat
                            border-left: 1px solid var(--lp-glass-border)

                        strong
                            display: block
                            color: var(--lp-accent)
                            font-family: var(--font)
                            font-size: 1.4rem
                            font-weight: 400

                        span
                            display: block
                            margin-top: 4px
                            color: var(--lp-text-2)
                            font-size: 0.65rem

            .ProfileContentStack
                min-width: 0
                display: grid
                gap: 17px

                .ProfileCard
                    padding: 22px
                    border: 1px solid var(--lp-glass-border)
                    border-radius: 18px
                    background: var(--lp-glass-bg)
                    box-shadow: unquote("inset 0 1px color-mix(in srgb, var(--lp-text-1) 4%, transparent), 0 20px 55px rgba(0, 0, 0, 0.18)")

                    .ProfileCardHead
                        margin-bottom: 18px
                        display: flex
                        align-items: center
                        justify-content: space-between
                        gap: 16px

                        .ProfileCardTitle
                            margin: 0
                            font-size: 0.83rem
                            font-weight: 700
                            letter-spacing: 0.08em
                            text-transform: uppercase
                            color: var(--lp-text-1)

                        .ProfileCardNumber
                            color: var(--lp-text-3)
                            font-family: Menlo, Monaco, Consolas, monospace
                            font-size: 0.65rem

                    .ProfileFieldGrid
                        display: grid
                        grid-template-columns: repeat(2, minmax(0, 1fr))
                        gap: 12px

                        .ProfileField
                            min-width: 0
                            padding: 15px
                            border: 1px solid var(--lp-glass-border)
                            border-radius: 12px
                            background: unquote("color-mix(in srgb, var(--lp-text-1) 3%, transparent)")

                            label
                                display: block
                                margin-bottom: 7px
                                color: var(--lp-text-3)
                                font-size: 0.59rem
                                font-weight: 800
                                letter-spacing: 0.1em
                                text-transform: uppercase

                            p
                                display: block
                                overflow: hidden
                                margin: 0
                                color: var(--lp-text-1)
                                font-size: 0.78rem
                                text-overflow: ellipsis
                                white-space: nowrap

                                &.ProfileFieldMono
                                    font-family: Menlo, Monaco, Consolas, monospace
                                    font-size: 0.7rem
                                    letter-spacing: 0.04em

                    .ProfileEmptyState
                        margin: 0
                        color: var(--lp-text-3)
                        font-size: 0.75rem

                    .ProfileLicenseList
                        display: grid
                        gap: 8px

                        .ProfileLicenseItem
                            padding: 14px 15px
                            display: grid
                            grid-template-columns: 110px 1fr auto
                            gap: 15px
                            align-items: center
                            border: 1px solid var(--lp-glass-border)
                            border-radius: 12px
                            background: unquote("color-mix(in srgb, var(--lp-text-1) 3%, transparent)")

                            .ProfileLicenseId
                                color: var(--lp-accent)
                                font-family: Menlo, Monaco, Consolas, monospace
                                font-size: 0.75rem
                                font-weight: 700

                            .ProfileLicenseDetails
                                min-width: 0

                                strong
                                    display: block
                                    font-size: 0.77rem
                                    font-weight: 600
                                    color: var(--lp-text-1)

                                span
                                    display: block
                                    margin-top: 3px
                                    color: var(--lp-text-2)
                                    font-size: 0.67rem

                            .ProfileLicenseYear
                                color: var(--lp-text-2)
                                font-size: 0.67rem

                    .ProfileWorkplace
                        display: grid
                        gap: 12px

                        .ProfileWorkRow
                            padding-bottom: 12px
                            border-bottom: 1px solid var(--lp-glass-border)

                            &:last-child
                                padding: 0
                                border: 0

                            span
                                display: block
                                color: var(--lp-text-2)
                                font-size: 0.61rem
                                letter-spacing: 0.08em
                                text-transform: uppercase

                            strong
                                display: block
                                margin-top: 5px
                                font-size: 0.77rem
                                font-weight: 600
                                color: var(--lp-text-1)

                    .ProfileVerificationBody
                        display: grid
                        grid-template-columns: 1fr 74px
                        gap: 17px
                        align-items: center

                        .ProfileVerificationData
                            display: grid
                            gap: 11px

                            .ProfileVerificationRow
                                display: flex
                                justify-content: space-between
                                gap: 12px
                                font-size: 0.7rem

                                span
                                    color: var(--lp-text-2)

                                strong
                                    font-weight: 600
                                    text-align: right
                                    color: var(--lp-text-1)

                        .ProfileIdPhoto
                            width: 74px
                            height: 74px
                            overflow: hidden
                            display: grid
                            place-items: center
                            border: 1px solid var(--lp-glass-border-hi)
                            border-radius: 14px
                            color: var(--bg)
                            background: linear-gradient(145deg, var(--lp-accent), var(--lp-accent-2))
                            font-family: var(--font)
                            font-size: 1rem

                            img
                                width: 100%
                                height: 100%
                                object-fit: cover

                    .ProfileValidityBadge
                        width: fit-content
                        padding: 5px 9px
                        border-radius: var(--lp-r-pill)
                        font-size: 0.64rem
                        font-weight: 800
                        white-space: nowrap

                        &[data-valid="true"]
                            color: var(--green)
                            background: unquote("color-mix(in srgb, var(--green) 14%, transparent)")

                        &[data-valid="false"]
                            color: var(--yellow)
                            background: unquote("color-mix(in srgb, var(--yellow) 14%, transparent)")

                .ProfileLowerGrid
                    display: grid
                    grid-template-columns: 1fr 1fr
                    gap: 17px
                    align-items: start



@media (max-width: 800px)
    .AccountSection
        .innerAccountContainer
            height: 800px

            .LogRegisterSection
                transform: translate(0%, 0%)

            .NewsSection
                transform: translate(0%, 0%)
                .bgImgContainer
                    background-size: 100% 120% !important

            .ProfileSection
                padding: 0 15px 90px

                .ProfileHeading
                    padding: 26px 0 22px
                    align-items: flex-start
                    flex-direction: column
                    gap: 16px

                    .ProfileHeadingActions
                        width: 100%
                        justify-content: flex-start

                .ProfileLayout
                    grid-template-columns: 1fr

                .ProfileLeftPanel
                    position: relative
                    top: auto

                .ProfileContentStack
                    .ProfileCard
                        .ProfileFieldGrid
                            grid-template-columns: 1fr

                        .ProfileLicenseList
                            .ProfileLicenseItem
                                grid-template-columns: 1fr auto

                                .ProfileLicenseDetails
                                    grid-column: 1 / -1
                                    grid-row: 2

                    .ProfileLowerGrid
                        grid-template-columns: 1fr



.ProfileLogout
    width: 100%
    min-height: 42px
    padding: 0 14px
    border: unquote("1px solid color-mix(in srgb, var(--red) 30%, transparent)")
    border-radius: 11px
    color: var(--red)
    background: unquote("color-mix(in srgb, var(--red) 8%, transparent)")
    font-size: 0.72rem
    font-weight: 700
    cursor: pointer
    transition: background 0.18s var(--lp-ease), border-color 0.18s var(--lp-ease)

    &:hover
        background: unquote("color-mix(in srgb, var(--red) 16%, transparent)")
        border-color: unquote("color-mix(in srgb, var(--red) 55%, transparent)")

.ProfileModalBtn
    min-height: 40px
    padding: 0 14px
    display: inline-flex
    align-items: center
    justify-content: center
    gap: 7px
    border: 1px solid var(--lp-glass-border-hi)
    border-radius: 10px
    color: var(--lp-text-1)
    background: unquote("color-mix(in srgb, var(--lp-accent) 6%, transparent)")
    font-size: 0.7rem
    font-weight: 800
    cursor: pointer
    transition: background 0.18s var(--lp-ease)

    &:hover
        background: unquote("color-mix(in srgb, var(--lp-accent) 14%, transparent)")

.ProfileLogoutModal
    fillSpace()
    padding: 25px
    display: flex
    flex-direction: column
    justify-content: center
    border-radius: 20px
    background: var(--lp-bg-mid)

    h2
        margin: 0 0 9px
        font-size: 1.05rem
        font-weight: 600
        color: var(--lp-text-1)

    p
        margin: 0
        color: var(--lp-text-2)
        font-size: 0.76rem
        line-height: 1.6

    .ProfileLogoutModalActions
        margin-top: 21px
        display: flex
        justify-content: flex-end
        gap: 8px

        .ProfileLogout
            width: auto
