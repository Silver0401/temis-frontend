.SharedConsentPage
    min-height: 100dvh
    width: 100%
    padding: 20px 12px 48px
    background: var(--bg)
    color: var(--white)

    .publicConsentDocument
        width: min(100%, 820px)
        margin: 0 auto
        border: 1px solid var(--silver)
        border-radius: 18px
        overflow: hidden
        background: var(--bg)

        > header
            padding: 26px 20px
            border-bottom: 1px solid var(--silver)

            h1
                margin: 8px 0 20px
                font-size: clamp(1.65rem, 7vw, 2.5rem)
                line-height: 1.1

            dl
                display: grid
                gap: 10px

                div
                    display: grid
                    grid-template-columns: 92px 1fr
                    gap: 8px

                dt
                    color: var(--grey)
                    font-size: 0.75rem
                    text-transform: uppercase

                dd
                    margin: 0
                    overflow-wrap: anywhere

    .consentEyebrow
        margin: 0
        color: var(--primary)
        font-size: 0.74rem
        letter-spacing: 0.08em
        text-transform: uppercase

    .publicConsentBody
        padding: 24px 20px

        p
            margin: 0 0 16px
            color: var(--white)
            font-size: 0.95rem
            line-height: 1.72
            white-space: pre-wrap

            &[data-heading="true"]
                margin-top: 26px
                margin-bottom: 10px
                color: var(--primary)
                font-size: 0.78rem
                font-weight: 700
                letter-spacing: 0.07em

    .publicConsentEvidence
        padding: 24px 20px
        border-top: 1px solid var(--silver)

        h2
            margin: 0 0 8px
            font-size: 1.35rem

        > p
            color: var(--grey)
            line-height: 1.55

        label
            display: block
            margin: 20px 0 7px
            font-size: 0.82rem
            font-weight: 600

        input
            width: 100%
            min-height: 46px
            padding: 0 13px
            border: 1px solid var(--silver)
            border-radius: 10px
            outline: none
            background: var(--bg)
            color: var(--white)
            font: inherit

            &:focus
                border-color: var(--primary)

    .consentModeTabs
        display: grid
        grid-template-columns: 1fr 1fr
        gap: 8px
        margin: 18px 0

        button
            min-height: 44px
            padding: 8px 12px
            border: 1px solid var(--silver)
            border-radius: 10px
            background: var(--bg)
            color: var(--white)
            font: inherit
            cursor: pointer

            &[aria-selected="true"]
                border-color: var(--primary)
                color: var(--primary)

    .typedAcceptance
        padding: 18px
        border: 1px solid var(--silver)
        border-radius: 12px

        p
            margin: 0 0 16px
            line-height: 1.55

        button
            width: 100%
            min-height: 46px
            border: 0
            border-radius: 10px
            background: var(--primary)
            color: var(--dual)
            font: inherit
            font-weight: 700
            cursor: pointer

            &:disabled
                opacity: 0.45
                cursor: not-allowed

    .consentSigningError
        color: var(--red) !important

    .consentHash
        margin-top: 22px
        font-family: monospace
        font-size: 0.68rem
        overflow-wrap: anywhere

    &.consentStatePage
        display: grid
        place-items: center

    .consentStateCard
        width: min(100%, 520px)
        padding: 34px 24px
        border: 1px solid var(--silver)
        border-radius: 18px
        text-align: center

        h1
            margin: 0 0 10px

        p
            margin: 0
            color: var(--grey)

        > span
            display: inline-grid
            place-items: center
            width: 52px
            height: 52px
            margin-bottom: 16px
            border-radius: 50%
            background: var(--green-inverted)
            color: var(--green)
            font-size: 1.8rem

@media (min-width: 700px)
    .SharedConsentPage
        padding: 44px 20px 70px

        .publicConsentDocument
            > header, .publicConsentBody, .publicConsentEvidence
                padding-left: 44px
                padding-right: 44px
