// ═══════════════════════════════════════════════════════════════════════════════
// CRONOS MD — LANDING PAGE
// Diseño "Holographic Clinical" — el gemelo digital 3D como protagonista.
// Todas las clases con prefijo lp- para evitar colisiones.
// ═══════════════════════════════════════════════════════════════════════════════

// Keyframes globales (usados también por Loaders / InputCC — no eliminar)
@keyframes rotate {
    from {
        transform: rotate(0deg)
    }
    to{

        transform: rotate(360deg)
    }
}

@keyframes rotateLeft {
    from {
        transform: rotate(0deg)
    }
    to{

        transform: rotate(-360deg)
    }
}

.lp-risk-High
  --risk: #ff4343

.lp-risk-Medium
  --risk: #ff7843

.lp-risk-Low
  --risk: #fff243

.lp-risk-Controlled
  --risk: #43ff9e

// ═══════════════════════════════════════════════════════════════════════════════
// BACKGROUND CANVAS (montado global en layout.tsx)
// ═══════════════════════════════════════════════════════════════════════════════

.lp-bg-canvas
  position fixed
  inset 0
  z-index -1
  overflow hidden
  pointer-events none

.lp-bg-gradient
  position absolute
  inset 0
  background radial-gradient(ellipse 80% 60% at 10% 10%, var(--lp-bg-orb-a) 0%, transparent 60%),
             radial-gradient(ellipse 60% 50% at 90% 30%, var(--lp-bg-orb-b) 0%, transparent 55%),
             radial-gradient(ellipse 70% 60% at 50% 80%, var(--lp-bg-orb-c) 0%, transparent 60%),
             radial-gradient(ellipse 100% 100% at 50% 50%, var(--lp-bg-mid) 0%, var(--lp-bg-from) 100%)

.lp-bg-dots
  position absolute
  inset 0
  background-image radial-gradient(circle, var(--lp-bg-dots) 1px, transparent 1px)
  background-size 40px 40px
  mask-image radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%)

.lp-orb
  position absolute
  border-radius 50%
  filter blur(80px)
  opacity 0.55
  will-change transform

.lp-orb-1
  width 600px
  height 600px
  background radial-gradient(circle, var(--lp-orb-1) 0%, transparent 70%)
  top -150px
  left -100px
  animation lp-float-1 18s ease-in-out infinite alternate

.lp-orb-2
  width 500px
  height 500px
  background radial-gradient(circle, var(--lp-orb-2) 0%, transparent 70%)
  top 20%
  right -100px
  animation lp-float-2 22s ease-in-out infinite alternate
  opacity 0.4

.lp-orb-3
  width 700px
  height 700px
  background radial-gradient(circle, var(--lp-orb-3) 0%, transparent 70%)
  bottom -200px
  left 30%
  animation lp-float-3 26s ease-in-out infinite alternate
  opacity 0.3

.lp-orb-4
  width 400px
  height 400px
  background radial-gradient(circle, var(--lp-orb-4) 0%, transparent 70%)
  top 55%
  left -50px
  animation lp-float-1 20s ease-in-out infinite alternate-reverse
  opacity 0.25

@keyframes lp-float-1
  from
    transform translate(0, 0) scale(1)
  to
    transform translate(60px, 40px) scale(1.1)

@keyframes lp-float-2
  from
    transform translate(0, 0) scale(1)
  to
    transform translate(-40px, 60px) scale(0.95)

@keyframes lp-float-3
  from
    transform translate(0, 0) scale(1)
  to
    transform translate(50px, -40px) scale(1.08)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYOUT + REVEAL
// ═══════════════════════════════════════════════════════════════════════════════

.lp-wrap
  position relative
  z-index 1
  max-width var(--lp-s-max)
  margin 0 auto
  padding 0 var(--lp-s-pad)

.lp-wrap-wide
  max-width clamp(1180px, 92vw, 1520px)

.lp-rv
  opacity 0
  transform translateY(28px)
  transition opacity 0.75s var(--lp-ease), transform 0.75s var(--lp-ease)

  &.lp-in
    opacity 1
    transform translateY(0)

@media (prefers-reduced-motion: reduce)
  .lp-rv
    transform none
    transition opacity 0.3s ease-out

  .lp-rv.lp-in
    opacity 1

.lp-rv-d1
  transition-delay 0.08s

.lp-rv-d2
  transition-delay 0.16s

.lp-rv-d3
  transition-delay 0.24s

// ═══════════════════════════════════════════════════════════════════════════════
// HERO — "Constelación Vital"
// ═══════════════════════════════════════════════════════════════════════════════

.lp-hero
  min-height calc(100vh - var(--nav))
  display flex
  align-items center
  position relative
  overflow hidden
  z-index 1
  padding 40px 0 80px

// Palabra gigante de fondo
.lp-hero-bigword
  position absolute
  top 50%
  left 50%
  transform translate(-50%, -52%)
  font-family "Surgena", var(--font), sans-serif
  font-size clamp(94px, 21vw, 280px)
  letter-spacing 0.04em
  line-height 1
  white-space nowrap
  color transparent
  -webkit-text-stroke 1px rgba(123, 213, 165, 0.07)
  user-select none
  pointer-events none
  z-index 0
  animation lp-bigword-drift 16s ease-in-out infinite alternate

@keyframes lp-bigword-drift
  from
    transform translate(-51%, -52%)
  to
    transform translate(-49%, -50%)

// Grid técnico revelado por el cursor (--hx / --hy desde HeroSection)
.lp-hero-gridfx
  position absolute
  inset 0
  z-index 0
  pointer-events none
  background-image linear-gradient(var(--lp-glass-border-hi) 1px, transparent 1px),
                   linear-gradient(90deg, var(--lp-glass-border-hi) 1px, transparent 1px)
  background-size 44px 44px
  mask-image radial-gradient(240px circle at var(--hx, 70%) var(--hy, 40%), black 0%, transparent 75%)
  -webkit-mask-image radial-gradient(240px circle at var(--hx, 70%) var(--hy, 40%), black 0%, transparent 75%)
  opacity 0.85

// Halo que persigue al cursor
.lp-hero-cursorglow
  position absolute
  top 0
  left 0
  width 340px
  height 340px
  border-radius 50%
  background radial-gradient(circle, var(--lp-accent-glow) 0%, transparent 70%)
  opacity 0.35
  filter blur(20px)
  transform translate(calc(var(--hx, 60vw) - 170px), calc(var(--hy, 40vh) - 170px))
  transition transform 0.16s linear
  pointer-events none
  z-index 0

.lp-hero-grid
  display grid
  grid-template-columns 0.95fr 1.05fr
  gap clamp(24px, 4vw, 64px)
  align-items center
  position relative
  z-index 2

// ─── Copy ────────────────────────────────────────────────────
.lp-hero-copy
  position relative
  z-index 3

  > *
    animation lp-rise 0.9s var(--lp-ease) both

  > *:nth-child(2)
    animation-delay 0.1s
  > *:nth-child(3)
    animation-delay 0.2s
  > *:nth-child(4)
    animation-delay 0.3s
  > *:nth-child(5)
    animation-delay 0.42s

@keyframes lp-rise
  from
    opacity 0
    transform translateY(26px)
  to
    opacity 1
    transform translateY(0)

.lp-hero-badge
  display inline-flex
  align-items center
  gap 8px
  padding 5px 12px 5px 9px
  background var(--lp-accent-soft)
  border 1px solid var(--lp-glass-border-hi)
  border-radius var(--lp-r-pill)
  font-size 9px
  font-weight 400
  letter-spacing 0.1em
  text-transform uppercase
  color var(--primary)
  margin-bottom 24px

.lp-badge-dot
  width 6px
  height 6px
  border-radius 50%
  background var(--primary)
  box-shadow 0 0 8px var(--primary)
  animation lp-pulse-dot 2s ease infinite
  flex-shrink 0

@keyframes lp-pulse-dot
  0%, 100%
    opacity 1
    box-shadow 0 0 8px var(--primary)
  50%
    opacity 0.4
    box-shadow none

.lp-hero-title
  font-size clamp(37px, 6.4vw, 82px)
  font-weight 700
  line-height 0.98
  letter-spacing -0.02em
  color var(--lp-text-1)
  margin-bottom 22px
  text-wrap balance

  em
    font-style italic

// ─── Headline cinético ───────────────────────────────────────
.lp-kinetic
  .lp-line
    display block

  .lp-w
    display inline-block
    white-space nowrap

    & + .lp-w
      margin-left 0.24em

  .lp-ch
    display inline-block
    animation lp-ch-in 0.7s var(--lp-ease) both
    animation-delay calc(var(--i, 0) * 0.035s)
    transition transform 0.3s var(--lp-ease), color 0.3s ease-out
    cursor default

    @media (hover: hover) and (pointer: fine)
      &:hover
        transform translateY(-0.12em) rotate(-5deg)
        color var(--primary)

  em .lp-ch
    background linear-gradient(135deg, var(--primary), var(--lp-accent-2))
    -webkit-background-clip text
    -webkit-text-fill-color transparent
    background-clip text

    @media (hover: hover) and (pointer: fine)
      &:hover
        filter brightness(1.4)

@keyframes lp-ch-in
  from
    opacity 0
    transform translateY(0.55em) rotate(6deg)
  to
    opacity 1
    transform translateY(0) rotate(0)

.lp-hero-sub
  font-size var(--lp-t-body)
  font-weight 300
  color var(--lp-text-2)
  line-height 1.8
  margin-bottom 38px
  max-width 440px

.lp-hero-actions
  display flex
  align-items center
  gap 14px
  flex-wrap wrap

// Botones magnéticos
.lp-magnet
  display inline-block
  transition transform 0.25s var(--lp-ease)
  will-change transform

.lp-hero-stats
  display flex
  gap 28px
  margin-top 46px
  padding-top 34px
  border-top 1px solid var(--lp-glass-border)

.lp-hstat
  flex 1

.lp-hstat-n
  font-family "Surgena", var(--font), sans-serif
  font-size clamp(24px, 3vw, 34px)
  font-weight 700
  letter-spacing -0.02em
  color var(--lp-text-1)
  line-height 1
  margin-bottom 5px

  span
    color var(--primary)

.lp-hstat-l
  font-size 9px
  font-weight 300
  color var(--lp-text-3)
  letter-spacing 0.06em
  text-transform uppercase

// ─── Constelación vital (canvas de partículas) ───────────────
.lp-hero-fx
  position relative
  height clamp(460px, 74vh, 740px)
  z-index 2
  animation lp-fx-in 1.6s var(--lp-ease) both

@keyframes lp-fx-in
  from
    opacity 0
    transform scale(0.97)
  to
    opacity 1
    transform scale(1)

.lp-particles
  position absolute
  inset 0
  width 100%
  height 100%
  z-index 2

// Canvas del modelo 3D (R3F inyecta estilos inline — se sobreescriben)
.lp-show-stage
  .GenericHumanModelContainer
    position absolute !important
    inset 0
    z-index 2

.lp-stage-aura
  position absolute
  inset -10%
  background radial-gradient(ellipse 50% 45% at 50% 50%, var(--lp-accent-glow) 0%, transparent 70%)
  filter blur(10px)
  opacity 0.6
  animation lp-aura-pulse 5s ease-in-out infinite alternate
  pointer-events none
  z-index 0

@keyframes lp-aura-pulse
  from
    opacity 0.35
  to
    opacity 0.75

// Lecturas técnicas (micro copy del visor)
.lp-stage-readout
  position absolute
  top 14px
  left 16px
  font-size 10px
  font-weight 500
  letter-spacing 0.16em
  text-transform uppercase
  color var(--primary)
  display flex
  align-items center
  gap 6px
  z-index 4
  pointer-events none

.lp-visor-dot
  width 5px
  height 5px
  background var(--primary)
  border-radius 50%
  flex-shrink 0

// Punto de riesgo (usado por pills y leyendas)
.lp-hud-dot
  width 6px
  height 6px
  border-radius 50%
  background var(--risk, #0affe0)
  box-shadow 0 0 8px var(--risk, #0affe0)
  flex-shrink 0

// Marcas de esquina
.lp-c-mark
  position absolute
  width 14px
  height 14px
  z-index 4
  opacity 0.7
  pointer-events none

  &.lp-tl
    top 10px
    left 10px
    border-top 1.5px solid var(--hub-cyan)
    border-left 1.5px solid var(--hub-cyan)

  &.lp-tr
    top 10px
    right 10px
    border-top 1.5px solid var(--hub-cyan)
    border-right 1.5px solid var(--hub-cyan)

  &.lp-bl
    bottom 10px
    left 10px
    border-bottom 1.5px solid var(--hub-cyan)
    border-left 1.5px solid var(--hub-cyan)

  &.lp-br
    bottom 10px
    right 10px
    border-bottom 1.5px solid var(--hub-cyan)
    border-right 1.5px solid var(--hub-cyan)

// Indicador de scroll
.lp-hero-scrollcue
  position absolute
  bottom 22px
  left 50%
  transform translateX(-50%)
  display flex
  flex-direction column
  align-items center
  gap 10px
  z-index 3

  span
    font-size 9px
    font-weight 500
    letter-spacing 0.3em
    text-transform uppercase
    color var(--lp-text-3)

  i
    width 1px
    height 44px
    background linear-gradient(180deg, var(--primary), transparent)
    transform-origin top
    animation lp-cue 2.2s var(--lp-ease) infinite

@keyframes lp-cue
  0%
    transform scaleY(0)
  45%
    transform scaleY(1)
  100%
    transform scaleY(0)
    transform-origin bottom

// ═══════════════════════════════════════════════════════════════════════════════
// MARQUEE
// ═══════════════════════════════════════════════════════════════════════════════

.lp-marquee
  position relative
  z-index 1
  overflow hidden
  padding 20px 0
  border-bottom 1px solid var(--lp-glass-border)
  mask-image linear-gradient(90deg, transparent, black 12%, black 88%, transparent)

.lp-marquee-track
  display flex
  align-items center
  width max-content
  animation lp-marquee-scroll 30s linear infinite

@keyframes lp-marquee-scroll
  to
    transform translateX(-50%)

.lp-marquee-item
  display inline-flex
  align-items center
  font-family var(--font)
  font-size clamp(11px, 1.5vw, 14px)
  letter-spacing 0.22em
  text-transform uppercase
  color var(--lp-text-3)
  white-space nowrap

  &:nth-child(even)
    color var(--primary)

.lp-marquee-sep
  font-style normal
  margin 0 28px
  font-size 9px
  color var(--lp-glass-border-hi)

// ═══════════════════════════════════════════════════════════════════════════════
// BASE DE SECCIONES
// ═══════════════════════════════════════════════════════════════════════════════

.lp-section
  padding var(--lp-s-section) 0
  position relative
  z-index 1

.lp-section-tag
  display inline-flex
  align-items center
  gap 6px
  font-size var(--lp-t-micro)
  font-weight 500
  letter-spacing 0.1em
  text-transform uppercase
  color var(--primary)
  margin-bottom 20px

  &::before
    content "+"
    font-size 11px
    font-weight 300
    line-height 1
    opacity 0.7

.lp-s-title
  font-size var(--lp-t-h2)
  font-weight 700
  line-height 1.05
  letter-spacing -0.03em
  color var(--lp-text-1)
  margin-bottom 20px
  text-wrap balance

  em
    font-style italic
    color var(--primary)

.lp-s-title--full-grad
  color var(--primary)

.lp-s-sub
  font-size var(--lp-t-body)
  font-weight 300
  color var(--lp-text-2)
  line-height 1.8
  max-width 520px

.lp-testimonials-note
  font-size var(--lp-t-micro)
  font-style italic
  color var(--lp-text-2)
  margin-top -12px
  margin-bottom 20px

// ═══════════════════════════════════════════════════════════════════════════════
// FEATURES — STRIPS EXPANDIBLES
// ═══════════════════════════════════════════════════════════════════════════════

.lp-strips
  display flex
  gap 12px
  height clamp(480px, 64vh, 640px)
  margin-top 60px

.lp-strip
  position relative
  flex 1
  min-width 0
  background var(--lp-card-bg)
  border 1px solid var(--lp-glass-border)
  clip-path polygon(14px 0%, calc(100% - 14px) 0%, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0% calc(100% - 14px), 0% 14px)
  overflow hidden
  cursor pointer
  outline none
  transition flex 0.38s var(--lp-ease), border-color 0.3s ease-out, box-shadow 0.3s ease-out, background 0.38s var(--lp-ease)

  &::before
    content ""
    position absolute
    top 0
    left 0
    right 0
    height 120px
    background var(--lp-glass-shine)
    pointer-events none
    z-index 2

  &:hover
    border-color var(--lp-glass-border-hi)

.lp-strip-open
  flex 4.4
  border-color var(--lp-glass-border-hi)
  box-shadow 0 0 44px rgba(90, 222, 164, 0.07)

  &.lp-tone-cyan
    background linear-gradient(150deg, rgba(90, 222, 164,0.09) 0%, var(--lp-card-bg) 55%)
    border-color rgba(90, 222, 164,0.3)

  &.lp-tone-blue
    background linear-gradient(150deg, rgba(0, 159, 59,0.12) 0%, var(--lp-card-bg) 55%)
    border-color rgba(0, 159, 59,0.32)

  &.lp-tone-purple
    background linear-gradient(150deg, rgba(0, 159, 59,0.10) 0%, var(--lp-card-bg) 55%)
    border-color rgba(0, 159, 59,0.28)

// Estado colapsado: número arriba, título vertical, "+" abajo
.lp-strip-closed
  position absolute
  inset 0
  display flex
  flex-direction column
  align-items center
  justify-content space-between
  padding 22px 0
  opacity 1
  transition opacity 0.14s 0.3s
  z-index 1

.lp-strip-num
  font-size var(--lp-t-micro)
  font-weight 500
  letter-spacing 0.2em
  text-transform uppercase
  color var(--lp-text-3)

.lp-strip-vert
  writing-mode vertical-rl
  transform rotate(180deg)
  font-size clamp(13px, 1.4vw, 16px)
  font-weight 700
  letter-spacing 0.14em
  text-transform uppercase
  color var(--lp-text-2)
  white-space nowrap

.lp-strip-plus
  font-size 17px
  font-weight 300
  color var(--primary)

.lp-strip-open .lp-strip-closed
  opacity 0
  pointer-events none
  transition opacity 0.12s

// Estado expandido: demo arriba, texto abajo
.lp-strip-body
  position absolute
  inset 0
  display flex
  flex-direction column
  justify-content flex-end
  gap 10px
  padding 34px 32px
  opacity 0
  transform translateY(6px)
  transition opacity 0.12s ease-out, transform 0.12s var(--lp-ease)
  pointer-events none
  z-index 1

.lp-strip-open .lp-strip-body
  opacity 1
  transform translateY(0)
  transition opacity 0.26s ease-out 0.36s, transform 0.26s var(--lp-ease) 0.36s
  pointer-events auto

.lp-strip-demo
  flex 1
  display flex
  align-items center
  justify-content center
  min-height 0

.lp-strip-title
  font-size clamp(17px, 2.2vw, 26px)
  font-weight 700
  letter-spacing -0.02em
  color var(--lp-text-1)
  line-height 1.15

.lp-strip-desc
  font-size 11.5px
  font-weight 300
  color var(--lp-text-2)
  line-height 1.75
  max-width 480px

// ─── Micro-demos ─────────────────────────────────────────────

// Ondas de voz
// ─── Dictado por Voz — barras full-width con onda variada ─────────────────
.lp-wave-demo
  display flex
  align-items center
  gap 3px
  width 100%
  padding 0 20px
  height 110px

.lp-bwave
  flex 1
  min-height 4px
  border-radius 2px
  transform-origin center bottom
  background linear-gradient(180deg, var(--primary) 0%, var(--secondary) 100%)
  animation lp-bwave-a 1.4s ease-in-out infinite

  &:nth-child(2n)
    animation-name lp-bwave-b
    animation-duration 1.8s
    background linear-gradient(180deg, var(--secondary) 0%, var(--primary) 100%)

  &:nth-child(3n)
    animation-duration 1.1s

  &:nth-child(5n)
    animation-name lp-bwave-c
    animation-duration 2.1s

  &:nth-child(7n)
    animation-name lp-bwave-b
    animation-duration 0.95s

@keyframes lp-bwave-a
  0%, 100%
    transform scaleY(0.12)
  50%
    transform scaleY(0.9)

@keyframes lp-bwave-b
  0%, 100%
    transform scaleY(0.55)
  35%
    transform scaleY(0.08)
  65%
    transform scaleY(1)

@keyframes lp-bwave-c
  0%, 100%
    transform scaleY(0.25)
  28%
    transform scaleY(0.95)
  60%
    transform scaleY(0.15)
  80%
    transform scaleY(0.7)

// ─── OCR & Visión — scanner de documento ──────────────────────────────────
.lp-ocr-doc
  position relative
  width min(290px, 80%)
  background var(--lp-glass-bg)
  border 1px solid var(--lp-glass-border)
  border-radius 6px
  padding 16px 18px
  display flex
  flex-direction column
  gap 11px
  overflow hidden

.lp-ocr-beam
  position absolute
  left 0
  right 0
  height 2px
  background linear-gradient(90deg, transparent 2%, var(--secondary) 30%, var(--primary) 50%, var(--secondary) 70%, transparent 98%)
  box-shadow 0 0 8px var(--primary), 0 0 18px var(--secondary)
  animation lp-scan-move 4.5s linear infinite
  z-index 2

@keyframes lp-scan-move
  0%
    top 0
    opacity 0
  4%
    opacity 0.95
  80%
    opacity 0.95
    top calc(100% - 2px)
  86%, 100%
    top calc(100% - 2px)
    opacity 0

.lp-ocr-doc-head
  height 9px
  width 48%
  border-radius 3px
  background rgba(191, 230, 205, 0.25)
  margin-bottom 4px
  flex-shrink 0

.lp-ocr-row
  position relative
  height 8px
  flex-shrink 0

.lp-ocr-raw
  position absolute
  left 0
  top 0
  height 100%
  border-radius 3px
  background rgba(170, 223, 190, 0.22)
  transform-origin left center
  animation lp-ocr-raw-out 4.5s ease-in-out infinite
  animation-delay calc(var(--row) * 0.68s)

.lp-ocr-clean
  position absolute
  left 0
  top 0
  width 100%
  height 100%
  display flex
  gap 6px
  opacity 0
  animation lp-ocr-clean-in 4.5s ease-in-out infinite
  animation-delay calc(var(--row) * 0.68s)

  span:first-child
    flex-shrink 0
    width 24%
    height 100%
    border-radius 3px
    background var(--secondary)
    opacity 0.8

  span:last-child
    height 100%
    border-radius 3px
    background linear-gradient(90deg, var(--primary), var(--secondary))
    opacity 0.75

@keyframes lp-ocr-raw-out
  0%, 8%
    opacity 0.75
    transform scaleX(1)
  18%, 86%
    opacity 0
    transform scaleX(0.94)
  94%, 100%
    opacity 0.75
    transform scaleX(1)

@keyframes lp-ocr-clean-in
  0%, 10%
    opacity 0
  16%
    opacity 1
    filter drop-shadow(0 0 4px var(--secondary))
  22%, 84%
    opacity 0.82
    filter none
  92%, 100%
    opacity 0

// Cubo 3D en CSS puro
.lp-cube-scene
  perspective 700px

.lp-cube
  width 92px
  height 92px
  position relative
  transform-style preserve-3d
  animation lp-cube-spin 10s linear infinite

  i
    position absolute
    inset 0
    border 1px solid rgba(10, 255, 224, 0.45)
    background rgba(10, 255, 224, 0.05)

    &:nth-child(1)
      transform rotateY(0deg) translateZ(46px)
    &:nth-child(2)
      transform rotateY(90deg) translateZ(46px)
    &:nth-child(3)
      transform rotateY(180deg) translateZ(46px)
    &:nth-child(4)
      transform rotateY(270deg) translateZ(46px)
    &:nth-child(5)
      transform rotateX(90deg) translateZ(46px)
    &:nth-child(6)
      transform rotateX(-90deg) translateZ(46px)

@keyframes lp-cube-spin
  from
    transform rotateX(-18deg) rotateY(0deg)
  to
    transform rotateX(-18deg) rotateY(360deg)

// Red neuronal pulsante
.lp-neural
  display grid
  grid-template-columns repeat(8, 16px)
  gap 16px

  i
    width 7px
    height 7px
    border-radius 50%
    background var(--primary)
    opacity 0.2
    animation lp-neural-pulse 1.9s ease-in-out infinite
    animation-delay calc(var(--i, 0) * 0.18s)

@keyframes lp-neural-pulse
  0%, 100%
    opacity 0.15
    transform scale(0.7)
    box-shadow none
  50%
    opacity 1
    transform scale(1.25)
    box-shadow 0 0 10px var(--primary)

// Radar de seguridad
.lp-radar
  width 130px
  height 130px
  border-radius 50%
  border 1px solid var(--lp-glass-border-hi)
  background repeating-radial-gradient(circle, transparent 0 24px, rgba(10, 255, 224, 0.12) 25px)
  position relative
  overflow hidden

  &::before
    content ""
    position absolute
    inset 0
    background conic-gradient(rgba(10, 255, 224, 0.5), transparent 70deg, transparent)
    animation rotate 3.2s linear infinite

  &::after
    content ""
    position absolute
    top 50%
    left 50%
    width 6px
    height 6px
    margin -3px
    border-radius 50%
    background var(--primary)
    box-shadow 0 0 10px var(--primary)

// ═══════════════════════════════════════════════════════════════════════════════
// SHOWCASE — GEMELO DIGITAL INTERACTIVO (modelo sticky + casos clínicos)
// ═══════════════════════════════════════════════════════════════════════════════

.lp-show-layout
  display grid
  grid-template-columns 1fr 1fr
  gap clamp(28px, 4vw, 64px)
  margin-top 64px
  align-items start

.lp-show-stage
  position sticky
  top 4vh
  height 88vh
  border 1px solid var(--lp-glass-border)
  clip-path polygon(18px 0%, calc(100% - 18px) 0%, 100% 18px, 100% calc(100% - 18px), calc(100% - 18px) 100%, 18px 100%, 0% calc(100% - 18px), 0% 18px)
  background linear-gradient(180deg, rgba(90, 222, 164,0.03) 0%, transparent 40%)
  overflow hidden

  .lp-stage-aura
    inset 0

.lp-show-legend
  position absolute
  bottom 14px
  left 50%
  transform translateX(-50%)
  display flex
  gap 8px
  z-index 4

.lp-legend-item
  display inline-flex
  align-items center
  gap 6px
  font-size 9px
  font-weight 500
  letter-spacing 0.12em
  text-transform uppercase
  color var(--lp-text-3)
  padding 4px 10px
  border-radius var(--lp-r-pill)
  border 1px solid var(--lp-glass-border)
  background var(--lp-glass-bg-lite)

  &::before
    content ""
    width 6px
    height 6px
    border-radius 50%
    background var(--risk, #0affe0)

.lp-case-list
  display flex
  flex-direction column
  gap 18px

.lp-case-list
  &:has(.lp-case-card:hover) .lp-case-card:not(:hover),
  &:has(.lp-case-card.lp-case-active) .lp-case-card:not(.lp-case-active)
    opacity 0.35

.lp-case-card
  position relative
  min-height 44vh
  display flex
  flex-direction column
  justify-content center
  padding 40px 36px
  background var(--lp-card-bg)
  border 1px solid var(--lp-glass-border)
  clip-path polygon(14px 0%, calc(100% - 14px) 0%, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0% calc(100% - 14px), 0% 14px)
  overflow hidden
  cursor pointer
  transition opacity 0.35s var(--lp-ease), border-color 0.35s ease-out, transform 0.35s var(--lp-ease), box-shadow 0.35s ease-out

  &::before
    content ""
    position absolute
    top 0
    left 0
    right 0
    height 100px
    background var(--lp-glass-shine)
    pointer-events none

  &.lp-case-active
    border-color unquote("color-mix(in srgb, var(--risk, #0affe0) 55%, transparent)")
    transform translateY(-3px)
    box-shadow 0 0 50px unquote("color-mix(in srgb, var(--risk, #0affe0) 12%, transparent)")

    .lp-case-idx
      -webkit-text-stroke-color unquote("color-mix(in srgb, var(--risk, #0affe0) 60%, transparent)")

  @media (hover: hover) and (pointer: fine)
    &:hover
      border-color unquote("color-mix(in srgb, var(--risk, #0affe0) 55%, transparent)")
      transform translateY(-3px)
      box-shadow 0 0 50px unquote("color-mix(in srgb, var(--risk, #0affe0) 12%, transparent)")

      .lp-case-idx
        -webkit-text-stroke-color unquote("color-mix(in srgb, var(--risk, #0affe0) 60%, transparent)")

.lp-case-idx
  position absolute
  top 18px
  right 24px
  font-family "Surgena", var(--font), sans-serif
  font-size clamp(48px, 6vw, 78px)
  line-height 1
  color transparent
  -webkit-text-stroke 1px var(--lp-glass-border-hi)
  transition -webkit-text-stroke-color 0.35s
  pointer-events none

.lp-case-sys
  display inline-flex
  align-items center
  gap 8px
  font-size var(--lp-t-micro)
  font-weight 500
  letter-spacing 0.18em
  text-transform uppercase
  color var(--risk, var(--primary))
  margin-bottom 14px

  &::before
    content ""
    width 18px
    height 1px
    background var(--risk, var(--primary))

.lp-case-dx
  font-size clamp(17px, 2.4vw, 26px)
  font-weight 700
  letter-spacing -0.02em
  color var(--lp-text-1)
  line-height 1.15
  margin-bottom 14px

.lp-case-desc
  font-size 12px
  font-weight 300
  color var(--lp-text-2)
  line-height 1.8
  max-width 420px
  margin-bottom 22px

.lp-case-pill
  display inline-flex
  align-items center
  gap 7px
  width fit-content
  font-size 9px
  font-weight 500
  letter-spacing 0.14em
  text-transform uppercase
  color var(--risk, var(--primary))
  padding 6px 14px
  border-radius var(--lp-r-pill)
  border 1px solid unquote("color-mix(in srgb, var(--risk, #0affe0) 35%, transparent)")
  background unquote("color-mix(in srgb, var(--risk, #0affe0) 8%, transparent)")

// ═══════════════════════════════════════════════════════════════════════════════
// WORKFLOW — FILAS EDITORIALES
// ═══════════════════════════════════════════════════════════════════════════════

.lp-flow
  margin-top 64px
  border-top 1px solid var(--lp-glass-border)

.lp-flow-row
  display grid
  grid-template-columns 110px 1fr 1.4fr 44px
  gap clamp(18px, 3vw, 40px)
  align-items center
  padding 42px 10px
  border-bottom 1px solid var(--lp-glass-border)
  position relative
  transition background 0.35s

  @media (hover: hover) and (pointer: fine)
    &:hover
      background rgba(90, 222, 164, 0.03)

      .lp-flow-num
        -webkit-text-stroke-color var(--primary)
        opacity 1

      .lp-flow-arrow
        opacity 1
        transform translateX(0)

.lp-flow-num
  font-family "Surgena", var(--font), sans-serif
  font-size clamp(37px, 5vw, 61px)
  line-height 1
  color transparent
  -webkit-text-stroke 1px var(--lp-text-3)
  opacity 0.65
  transition -webkit-text-stroke-color 0.35s ease-out, opacity 0.35s ease-out

.lp-flow-title
  font-size clamp(15px, 2vw, 20px)
  font-weight 700
  letter-spacing -0.01em
  color var(--lp-text-1)
  line-height 1.2

.lp-flow-desc
  font-size 12px
  font-weight 300
  color var(--lp-text-2)
  line-height 1.75

.lp-flow-arrow
  display grid
  place-items center
  opacity 0
  transform translateX(-12px)
  transition opacity 0.35s ease-out, transform 0.35s var(--lp-ease)

  svg
    width 26px
    height 26px
    color var(--primary)

// ═══════════════════════════════════════════════════════════════════════════════
// TESTIMONIOS
// ═══════════════════════════════════════════════════════════════════════════════

.lp-quotes-grid
  display grid
  grid-template-columns repeat(3, 1fr)
  gap 18px
  margin-top 70px

.lp-quote-glass
  background var(--lp-card-bg)
  border 1px solid var(--lp-glass-border)
  clip-path polygon(14px 0%, calc(100% - 14px) 0%, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0% calc(100% - 14px), 0% 14px)
  padding 38px 32px
  position relative
  overflow hidden
  transition border-color 0.3s, transform 0.3s var(--lp-ease)

  &::before
    content ""
    position absolute
    top 0
    left 0
    right 0
    height 80px
    background var(--lp-glass-shine)
    pointer-events none

  &:hover
    border-color var(--lp-glass-border-hi)
    transform translateY(-4px)

  @media (min-width: 1025px)
    &:nth-child(2)
      transform translateY(26px)

      &:hover
        transform translateY(22px)

.lp-q-mark
  font-family "DM Serif Display", serif
  font-size 54px
  line-height 0.6
  background linear-gradient(135deg, var(--primary), var(--lp-accent-2))
  -webkit-background-clip text
  -webkit-text-fill-color transparent
  background-clip text
  margin-bottom 22px
  display block

.lp-q-text
  font-family "DM Serif Display", serif
  font-size 16px
  font-weight 400
  font-style italic
  color var(--lp-text-2)
  line-height 1.65
  margin-bottom 28px

  em
    font-style normal
    color var(--lp-text-1)

.lp-q-divider
  width 36px
  height 1px
  background linear-gradient(90deg, var(--primary), transparent)
  margin-bottom 18px

.lp-q-name
  font-size 12px
  font-weight 500
  color var(--lp-text-1)
  margin-bottom 3px

.lp-q-role
  font-size 9px
  font-weight 300
  color var(--lp-text-3)
  letter-spacing 0.04em

// ═══════════════════════════════════════════════════════════════════════════════
// PRICING
// ═══════════════════════════════════════════════════════════════════════════════

.lp-pricing-grid
  display grid
  grid-template-columns repeat(3, 1fr)
  gap 16px
  margin-top 60px

.lp-plan-glass
  background var(--lp-card-bg)
  border 1px solid var(--lp-glass-border)
  clip-path polygon(14px 0%, calc(100% - 14px) 0%, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0% calc(100% - 14px), 0% 14px)
  padding 36px 32px
  position relative
  overflow hidden
  display flex
  flex-direction column
  transition border-color 0.3s, transform 0.3s var(--lp-ease)

  &::before
    content ""
    position absolute
    top 0
    left 0
    right 0
    height 120px
    background var(--lp-glass-shine)
    pointer-events none
    z-index 0

  & > *
    position relative
    z-index 1

  &:hover
    border-color var(--lp-glass-border-hi)
    transform translateY(-4px)

  &.lp-featured
    border-color var(--lp-glass-border-hi)
    background linear-gradient(160deg, rgba(90, 222, 164,0.07) 0%, var(--lp-glass-bg) 50%)
    transform translateY(-8px)
    box-shadow 0 0 60px rgba(90, 222, 164,0.1), 0 20px 60px var(--lp-featured-shadow)

    &:hover
      transform translateY(-12px)
      border-color rgba(90, 222, 164,0.4)

.lp-plan-popular
  position absolute
  top 18px
  right 18px
  font-size 8px
  font-weight 600
  letter-spacing 0.14em
  text-transform uppercase
  color #000f06
  background linear-gradient(135deg, var(--lp-accent), #00c8d8)
  padding 4px 10px
  border-radius var(--lp-r-pill)
  z-index 2

.lp-plan-tier
  font-size var(--lp-t-micro)
  font-weight 500
  letter-spacing 0.18em
  text-transform uppercase
  color var(--lp-text-3)
  margin-bottom 20px

  &.lp-featured-tier
    color var(--primary)

.lp-plan-price
  font-size clamp(36px, 5vw, 49px)
  font-weight 700
  letter-spacing -0.04em
  color var(--lp-text-1)
  line-height 1
  margin-bottom 5px

  sup
    font-size 0.4em
    vertical-align top
    margin-top 10px
    display inline-block

  .lp-per
    font-size 14px
    font-weight 300
    color var(--lp-text-3)

.lp-plan-label
  font-size clamp(27px, 4vw, 37px)

.lp-plan-sub
  font-size 10px
  font-weight 300
  color var(--lp-text-3)
  margin-bottom 28px

.lp-plan-rule
  height 1px
  background var(--lp-glass-border)
  margin 20px 0

.lp-plan-feats
  display flex
  flex-direction column
  gap 12px
  flex 1
  margin-bottom 28px
  list-style none
  padding 0

.lp-pf
  display flex
  align-items flex-start
  gap 10px
  font-size 11px
  font-weight 300
  color var(--lp-text-2)
  line-height 1.4

  &::before
    content ""
    width 15px
    height 15px
    border-radius 50%
    border 1px solid var(--lp-glass-border-hi)
    flex-shrink 0
    margin-top 1px
    background var(--lp-accent-soft) url("data:image/svg+xml,%3Csvg viewBox='0 0 15 15' xmlns='http://www.w3.org/2000/svg'%3E%3Cpolyline points='3,7.5 6,10.5 12,4.5' stroke='%230AFFE0' stroke-width='1.2' fill='none' stroke-linecap='round'/%3E%3C/svg%3E") center/contain no-repeat

.lp-plan-btn
  display block
  text-align center
  padding 11px
  border-radius var(--lp-r-pill)
  font-size 11px
  font-weight 500
  letter-spacing 0.04em
  transition all 0.25s var(--lp-ease)
  margin-top auto
  text-decoration none

  &.lp-outline
    border 1px solid var(--lp-glass-border)
    color var(--lp-text-2)

    &:hover
      border-color var(--lp-glass-border-hi)
      color var(--lp-text-1)

  &.lp-glow
    background linear-gradient(135deg, var(--primary), var(--secondary))
    color var(--lp-plan-glow-text)
    box-shadow unquote("0 0 24px color-mix(in srgb, var(--primary) 35%, transparent)")

    &:hover
      box-shadow unquote("0 0 40px color-mix(in srgb, var(--primary) 55%, transparent)")
      transform translateY(-1px)

// ═══════════════════════════════════════════════════════════════════════════════
// CTA
// ═══════════════════════════════════════════════════════════════════════════════

.lp-cta-section
  padding var(--lp-s-section) 0
  position relative
  z-index 1
  text-align center
  overflow hidden

.lp-cta-glow-bg
  position absolute
  top 50%
  left 50%
  transform translate(-50%, -50%)
  width 700px
  height 400px
  background radial-gradient(ellipse, rgba(10,255,224,0.08) 0%, transparent 70%)
  pointer-events none

.lp-cta-orbit
  position absolute
  top 50%
  left 50%
  width 540px
  height 540px
  margin -270px 0 0 -270px
  border-radius 50%
  border 1px dashed rgba(90, 222, 164, 0.14)
  animation rotate 46s linear infinite
  pointer-events none

  &::before
    content ""
    position absolute
    top -3px
    left 50%
    width 6px
    height 6px
    border-radius 50%
    background var(--primary)
    box-shadow 0 0 10px var(--primary)

  &.lp-cta-orbit-2
    width 760px
    height 760px
    margin -380px 0 0 -380px
    border-color rgba(0, 159, 59, 0.12)
    animation rotateLeft 70s linear infinite

    &::before
      background var(--lp-accent-2)
      box-shadow 0 0 10px var(--lp-accent-2)

.lp-cta-inner
  position relative
  z-index 1
  padding 60px 0

.lp-cta-tag
  &::after
    content ""
    width 20px
    height 1px
    background var(--primary)

.lp-cta-title
  font-size clamp(34px, 5.6vw, 61px)
  font-weight 700
  letter-spacing -0.03em
  line-height 1.02
  color var(--lp-text-1)
  margin-bottom 22px
  text-wrap balance

  em
    font-style italic
    background linear-gradient(135deg, var(--primary), var(--lp-accent-2))
    -webkit-background-clip text
    -webkit-text-fill-color transparent
    background-clip text

.lp-cta-sub
  font-size var(--lp-t-body)
  font-weight 300
  color var(--lp-text-2)
  margin 0 auto 40px
  line-height 1.7
  max-width 460px

.lp-cta-btns
  display flex
  gap 14px
  justify-content center
  flex-wrap wrap

// ═══════════════════════════════════════════════════════════════════════════════
// SPECIALTIES SECTION — Vercel-style two-column layout
// ═══════════════════════════════════════════════════════════════════════════════

.lp-sp-section
  padding var(--lp-s-section) 0
  position relative
  z-index 1

.lp-sp-wrap
  position relative
  z-index 1
  max-width clamp(1180px, 92vw, 1520px)
  margin 0 auto
  padding 0 var(--lp-s-pad)
  display grid
  grid-template-columns 360px 1fr
  gap 80px
  align-items start

.lp-sp-left
  position sticky
  top 100px
  display flex
  flex-direction column
  gap 0

.lp-sp-title
  font-size clamp(24px, 3.5vw, 41px)
  font-weight 700
  line-height 1.1
  letter-spacing -0.03em
  color var(--lp-text-1)
  margin-bottom 48px

  em
    font-style normal
    background linear-gradient(135deg, var(--primary), var(--secondary))
    -webkit-background-clip text
    -webkit-text-fill-color transparent
    background-clip text

.lp-sp-bullets
  list-style none
  display flex
  flex-direction column
  gap 28px

.lp-sp-bullet
  display flex
  align-items flex-start
  gap 14px
  font-size 13px
  font-weight 300
  line-height 1.65
  color var(--lp-text-2)

  strong
    color var(--lp-text-1)
    font-weight 600

.lp-sp-bullet-ico
  flex-shrink 0
  margin-top 2px
  color var(--lp-text-2)
  opacity 0.6

// ── Grid de cards ──────────────────────────────────────────────────────────

.lp-sp-grid
  display grid
  grid-template-columns 1fr 1fr
  gap 15px
  border-radius 4px
  overflow hidden

.lp-sp-item
  position relative
  min-height 220px
  display flex
  flex-direction column
  justify-content space-between
  background unquote("color-mix(in srgb, var(--sp-accent) 6%, var(--lp-card-bg))")
  border 1px solid var(--lp-glass-border)
  overflow hidden
  cursor default
  transition background 0.3s, transform 0.28s var(--lp-ease), box-shadow 0.28s var(--lp-ease), border-color 0.28s
  clip-path polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%)

  &:not(.lp-sp-item--dev)
    cursor pointer

    &:hover
      background unquote("color-mix(in srgb, var(--sp-accent) 12%, var(--lp-card-bg))")
      border-color unquote("color-mix(in srgb, var(--sp-accent) 55%, transparent)")
      box-shadow unquote("inset 0 0 0 1px color-mix(in srgb, var(--sp-accent) 45%, transparent)")
      transform translateY(-5px)

      .lp-sp-item-icon
        box-shadow unquote("0 0 32px color-mix(in srgb, var(--sp-accent) 40%, transparent)")
        background unquote("color-mix(in srgb, var(--sp-accent) 18%, var(--lp-card-bg))")
        filter unquote("drop-shadow(0 0 10px color-mix(in srgb, var(--sp-accent) 80%, transparent))")

      .lp-sp-item-glow
        opacity 1.4

  // Triángulo del fold en esquina superior derecha
  &::after
    content ""
    position absolute
    top 0
    right 0
    width 22px
    height 22px
    background unquote("color-mix(in srgb, var(--sp-accent) 30%, var(--lp-sp-fold-base))")
    clip-path polygon(0 0, 100% 100%, 100% 0)
    z-index 3
    transition background 0.3s

.lp-sp-item-dotgrid
  position absolute
  inset 0
  background-image unquote("linear-gradient(var(--lp-sp-dotgrid-line) 1px, transparent 1px), linear-gradient(90deg, var(--lp-sp-dotgrid-line) 1px, transparent 1px)")
  background-size 28px 28px
  pointer-events none
  z-index 0

.lp-sp-item-glow
  position absolute
  inset 0
  background unquote("radial-gradient(ellipse 65% 55% at 50% 38%, color-mix(in srgb, var(--sp-accent) 22%, transparent), transparent 70%)")
  pointer-events none
  z-index 1
  transition opacity 0.3s

.lp-sp-item-body
  position relative
  z-index 2
  flex 1
  display flex
  align-items center
  justify-content center
  padding 36px 24px 20px

.lp-sp-item-icon
  display flex
  align-items center
  justify-content center
  width 56px
  height 56px
  border-radius 50%
  border 1.5px solid unquote("color-mix(in srgb, var(--sp-accent) 50%, transparent)")
  background unquote("color-mix(in srgb, var(--sp-accent) 10%, var(--lp-sp-icon-overlay))")
  color var(--white)
  box-shadow unquote("0 0 20px color-mix(in srgb, var(--sp-accent) 20%, transparent)")
  filter unquote("drop-shadow(0 0 6px color-mix(in srgb, var(--sp-accent) 50%, transparent))")
  transition box-shadow 0.3s, background 0.3s, filter 0.3s

  svg
    width 28px
    height 28px
    flex-shrink 0
    fill var(--white)
    color var(--white)

.lp-sp-item-name
  position relative
  z-index 2
  padding 14px 17px
  font-size 12px
  font-weight 600
  letter-spacing -0.01em
  color var(--lp-sp-name-color)
  border-top 1px solid var(--lp-sp-name-border)

// ── Estado "en desarrollo" ──────────────────────────────────────────────────

.lp-sp-item--dev
  opacity 0.72
  cursor pointer
  text-decoration none

  &:hover
    opacity 0.88
    background unquote("color-mix(in srgb, var(--sp-accent) 10%, var(--lp-card-bg))")
    border-color unquote("color-mix(in srgb, var(--sp-accent) 35%, transparent)")
    transform translateY(-3px)

.lp-sp-dev-ribbon
  position absolute
  inset 0
  z-index 6
  overflow hidden
  pointer-events none

  span
    position absolute
    bottom 30px
    right -38px
    width 148px
    padding 5px 0
    background var(--lp-sp-ribbon-bg)
    color var(--lp-sp-ribbon-text)
    font-size 9px
    font-weight 700
    letter-spacing 0.14em
    text-align center
    text-transform uppercase
    transform rotate(-45deg)
    border-top 1px solid var(--lp-sp-ribbon-border)
    border-bottom 1px solid var(--lp-sp-ribbon-border)

// ═══════════════════════════════════════════════════════════════════════════════
// RESPONSIVE
// ═══════════════════════════════════════════════════════════════════════════════

@media (max-width: 1024px)
  .lp-hero
    padding 60px 0 90px
    min-height auto

  .lp-hero-grid
    grid-template-columns 1fr
    gap 40px

  .lp-hero-bigword
    font-size 28vw
    top 30%

  .lp-hero-cursorglow
    display none

  .lp-hero-fx
    height clamp(380px, 56vh, 520px)
    max-width 520px
    width 100%
    margin 0 auto

  .lp-strips
    flex-direction column
    height auto

  .lp-strip
    flex none
    height 72px
    transition height 0.55s var(--lp-ease), border-color 0.4s, background 0.5s

    &.lp-strip-open
      height 430px

  .lp-strip-closed
    flex-direction row
    padding 0 22px
    align-items center

  .lp-strip-vert
    writing-mode horizontal-tb
    transform none

  .lp-show-layout
    grid-template-columns 1fr

  .lp-show-stage
    position relative
    top 0
    height 62vh

  .lp-case-card
    min-height auto

  .lp-flow-row
    grid-template-columns 70px 1fr
    grid-template-rows auto auto
    row-gap 10px
    padding 32px 6px

    .lp-flow-desc
      grid-column 2

    .lp-flow-arrow
      display none

  .lp-sp-wrap
    grid-template-columns 1fr
    gap 48px

  .lp-sp-left
    position static

  .lp-quotes-grid
    grid-template-columns 1fr

  .lp-pricing-grid
    grid-template-columns 1fr

  .lp-plan-glass.lp-featured
    transform none

    &:hover
      transform translateY(-4px)

  .lp-cta-orbit
    display none

@media (max-width: 640px)
  .lp-hero-stats
    flex-direction column
    gap 20px

  .lp-hero-actions
    flex-direction column
    align-items flex-start

  .lp-hero-scrollcue
    display none

  .lp-hero-gridfx
    display none

  .lp-strip-open
    height 460px

  .lp-show-stage
    height 56vh

  .lp-show-legend
    flex-wrap wrap
    justify-content center
    width 92%

  .lp-cta-btns
    flex-direction column

@media (prefers-reduced-motion: reduce)
  .lp-orb-1,
  .lp-orb-2,
  .lp-orb-3,
  .lp-orb-4
    animation none

  .lp-hero-bigword
    animation none

  .lp-stage-aura
    animation none

  .lp-badge-dot
    animation none

  .lp-bwave
    animation none

  .lp-aura-pulse
    animation none

  .lp-strip
    transition flex 0.15s ease-out, border-color 0.15s ease-out, background 0.15s ease-out, box-shadow 0.15s ease-out

  .lp-strip-body,
  .lp-strip-open .lp-strip-body
    transition opacity 0.15s ease-out, transform 0s
    transform none
