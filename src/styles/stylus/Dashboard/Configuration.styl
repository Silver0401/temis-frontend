.ConfigurationContainer
    position: relative
    width: 100%
    height: 90%
    alignStuff(0,1,0,0)

    .TabsWrapper
        position: relative
        width: 300px
        height: 100%
        alignStuff(0,1,0,1)

        .textContainer
            position: relative
            width: 100%
            height: 300px
            alignStuff(0,1,0,1)

            h3,p
                color: var(--bg)

            p
                font-size: 0.8rem
                margin: 0px 20px
                text-align: justify
            

    .DisplayWrapper
        position: relative
        width: calc(100% - 350px)
        height: 100%


@media (max-width: 800px)
    .ConfigurationContainer
        flex-direction: column
    