.SavePatientContainer
    position: relative
    fillSpace()
    min-height: calc(100vh - var(--nav) - 24px)
    display: flex
    flex-direction: row
    justify-content: center
    align-items: stretch
    gap: 16px
    padding: 18px

    .SavePatientStack
        position: relative
        height: 100%
        width: 700px
        display: flex
        flex-direction: column
        gap: 14px

        // Enfermería no escribe nota: en su lugar va el aviso y el botón de guardar.
        .NursePatientSaveBar
            position: relative
            width: 100%
            display: flex
            flex-direction: column
            gap: 12px
            padding: 18px
            border-radius: 16px
            border: 1px solid var(--dash-line)
            background: var(--dash-card-bg)
            backdrop-filter: var(--dash-blur-card)
            -webkit-backdrop-filter: var(--dash-blur-card)
            box-shadow: var(--dash-shadow)

            p
                margin: 0
                font-size: 0.92rem
                line-height: 1.45
                opacity: 0.85

        .GeneralTextAreaContainer
            position: relative
            flex: 1
            min-height: 0
            width: 100%
            height: 100%

            // Unifica la superficie del textarea con las demás (glass dash)
            .ClinicalTextArea .LeftContainer .TextBgContainer
                margin: 0
                border-radius: 16px
                border: 1px solid var(--dash-line)
                background: var(--dash-card-bg)
                backdrop-filter: var(--dash-blur-card)
                -webkit-backdrop-filter: var(--dash-blur-card)
                box-shadow: var(--dash-shadow)
                height: 500px

    .PatientIdPanel
        position: relative
        flex: 0 0 auto
        width: 100%
        display: flex
        flex-direction: column
        overflow: hidden
        border-radius: 16px
        border: 1px solid var(--dash-line)
        background: var(--dash-card-bg)
        backdrop-filter: var(--dash-blur-card)
        box-shadow: var(--dash-shadow)
        animation: patientIdPanelIn 260ms var(--ease-out-quint) both

        .PatientIdPanel__head
            position: relative
            width: 100%
            display: flex
            gap: 12px
            align-items: center
            padding: 14px 18px
            background: var(--dash-shine)
            border: none
            cursor: pointer
            text-align: left
            font: inherit
            color: inherit
            transition: background-color 200ms var(--ease-out)

            &:hover
                background-color: var(--dash-chip-bg)

            &:focus-visible
                outline: 2px solid var(--dash-cyan)
                outline-offset: -2px

            .PatientIdPanel__avatar
                flex: 0 0 42px
                width: 42px
                height: 42px
                border-radius: 50%
                display: flex
                align-items: center
                justify-content: center
                font-family: "Poppins", sans-serif
                font-weight: 600
                font-size: 0.9rem
                color: var(--dash-app-bg)
                background: var(--dash-cyan)

                &[data-sex="Masculino"]
                    background: var(--dash-sex-m)

                &[data-sex="Femenino"]
                    background: var(--dash-sex-f)

            .PatientIdPanel__ident
                min-width: 0
                flex: 1

                .PatientIdPanel__name
                    font-family: "Poppins", sans-serif
                    font-size: 0.9rem
                    font-weight: 600
                    line-height: 1.25
                    color: var(--dash-text)
                    text-transform: capitalize

                .PatientIdPanel__curp
                    display: block
                    margin-top: 3px
                    font-size: 0.68rem
                    letter-spacing: 0.06em
                    color: var(--dash-text-2)
                    white-space: nowrap
                    overflow: hidden
                    text-overflow: ellipsis

            .PatientIdPanel__chevron
                flex: 0 0 auto
                width: 20px
                height: 20px
                margin-left: 8px
                color: var(--dash-text-2)
                transition: transform 300ms var(--ease-out-quint), color 200ms var(--ease-out)

        &[data-open="true"] .PatientIdPanel__head
            .PatientIdPanel__chevron
                transform: rotate(90deg)
                color: var(--dash-cyan)

        .PatientIdPanel__drawer
            display: grid
            grid-template-rows: 0fr
            transition: grid-template-rows 320ms var(--ease-out-quint)

            > .PatientIdPanel__grid
                min-height: 0
                overflow: hidden

        &[data-open="true"] .PatientIdPanel__drawer
            grid-template-rows: 1fr

        .PatientIdPanel__grid
            display: flex
            flex-wrap: wrap
            align-content: flex-start
            border-top: 1px solid var(--dash-line)

            .PatientIdPanel__row
                display: flex
                flex-direction: column
                gap: 3px
                padding: 12px 16px
                min-width: 130px
                border-right: 1px solid var(--dash-line)
                border-bottom: 1px solid var(--dash-line)

                .PatientIdPanel__label
                    font-family: "Poppins", sans-serif
                    font-size: 0.6rem
                    letter-spacing: 0.07em
                    text-transform: uppercase
                    color: var(--dash-text-3)

                .PatientIdPanel__value
                    font-family: "Poppins", sans-serif
                    font-size: 0.8rem
                    line-height: 1.3
                    color: var(--dash-text)
                    word-break: break-word

    @keyframes patientIdPanelIn
        from
            opacity: 0
            transform: translateY(-8px)
        to
            opacity: 1
            transform: translateY(0)

    @media (prefers-reduced-motion: reduce)
        .PatientIdPanel
            animation: none

            .PatientIdPanel__drawer
                transition: none

            .PatientIdPanel__chevron
                transition: none

    @media (max-width: 760px)
        .SavePatientStack
            width: 100%

    .OptionBallButtonsContainer
        position: relative
        flex: 0 0 auto
        height: 100%
        display: flex
        align-items: center
        z-index: var(--globalZ2)

        .InnerOptionBallButtonsContainer
            position: relative
            display: flex
            flex-direction: column
            gap: 12px
            padding: 12px
            border-radius: 18px
            border: 1px solid var(--dash-line)
            background: var(--dash-sidebar-bg)
            backdrop-filter: var(--dash-blur)
            -webkit-backdrop-filter: var(--dash-blur)
            box-shadow: var(--dash-shadow)

            .OptionBallButton
                position: relative
                width: 44px
                height: 44px
                border-radius: 13px
                display: flex
                align-items: center
                justify-content: center
                background: var(--dash-chip-bg)
                border: 1px solid var(--dash-line)
                color: var(--dash-text-2)
                cursor: pointer
                --ball-accent: var(--dash-cyan)
                transition: color 180ms var(--ease-out), border-color 180ms var(--ease-out), background-color 180ms var(--ease-out), transform 180ms var(--ease-out)

                svg
                    width: 55%
                    height: 55%
                    color: currentColor
                    fill: currentColor

                &:hover, &:focus-visible
                    color: var(--ball-accent)
                    border-color: var(--ball-accent)
                    background: var(--dash-glass-lite)
                    transform: translateY(-2px)
                    outline: none

                &:active
                    transform: translateY(0)

                // Estado activo: sección con items agregados
                &:has(.BallNumber)
                    color: var(--ball-accent)
                    border-color: var(--ball-accent)
                    background: var(--dash-glass-lite)

                .BallNumber
                    position: absolute
                    top: -6px
                    right: -6px
                    min-width: 18px
                    height: 18px
                    padding: 0 4px
                    display: flex
                    align-items: center
                    justify-content: center
                    font-family: "Poppins", sans-serif
                    font-size: 0.62rem
                    font-weight: 600
                    color: var(--dash-app-bg)
                    background: var(--ball-accent)
                    border-radius: 9px

                // Tooltip a la derecha (CSS puro, sin JS)
                &::after
                    content: attr(data-tooltip)
                    position: absolute
                    left: calc(100% + 12px)
                    top: 50%
                    transform: translateY(-50%) translateX(-6px)
                    padding: 6px 11px
                    border-radius: 9px
                    background: var(--dash-glass-solid)
                    border: 1px solid var(--dash-line)
                    color: var(--dash-text)
                    font-family: "Poppins", sans-serif
                    font-size: 0.7rem
                    white-space: nowrap
                    pointer-events: none
                    opacity: 0
                    box-shadow: var(--dash-shadow)
                    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out)
                    z-index: var(--globalZ4)

                &:hover::after, &:focus-visible::after
                    opacity: 1
                    transform: translateY(-50%) translateX(0)

            #Drugs
                --ball-accent: var(--dash-cyan)

            #Request
                --ball-accent: var(--dash-purple)

            #Imgs
                --ball-accent: var(--dash-risk-mid)

            #Labs
                --ball-accent: var(--dash-risk-high)

            #Somas
                --ball-accent: var(--dash-risk-ok)

            #DxDf
                --ball-accent: var(--dash-blue)


