.ConfirmMedRecord
    position: relative
    fillSpace()
    alignStuff(0,1,0,0)
    margin: 2rem
    padding: 0rem 2rem

    // El formulario dinámico del router vive aquí dentro. Sin esto se pega
    // a la izquierda y ocupa todo el ancho de la columna.
    .FormCC
        width: 60%
        min-width: 320px
        max-width: 100%

@media (max-width: 800px)
    .ConfirmMedRecord
        margin: 0
        padding: 12px

        .FormCC
            width: 100%
            min-width: 0
