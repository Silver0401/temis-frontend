.InsuranceReports
    width: 100%
    min-height: 100%
    padding: 24px
    display: flex
    flex-direction: column
    gap: 18px
    color: var(--dash-text)
    overflow-y: auto

    .InsuranceReportsHeader
        display: flex
        align-items: flex-end
        justify-content: space-between
        gap: 24px

        h2
            margin: 0 0 6px
            font-size: 1.45rem

        p
            max-width: 720px
            margin: 0
            color: var(--dash-text-2)
            line-height: 1.5

    .InsuranceFormatSelect,
    .InsuranceReviewField
        display: flex
        flex-direction: column
        gap: 6px
        font-size: 0.76rem
        color: var(--dash-text-2)

        input,
        textarea,
        select
            width: 100%
            border: 1px solid var(--dash-line)
            border-radius: 10px
            background: var(--dash-card-bg-2)
            color: var(--dash-text)
            padding: 10px 12px
            font: inherit

        textarea
            min-height: 96px
            resize: vertical

        input:focus,
        textarea:focus,
        select:focus
            outline: 2px solid var(--dash-accent)
            outline-offset: 2px

    .InsuranceFormatSelect
        min-width: 260px

    .InsuranceRecordPicker,
    .InsuranceReviewForm
        padding: 18px
        border: 1px solid var(--dash-line)
        border-radius: 16px
        background: var(--dash-card-bg)

        h3
            margin: 0 0 12px

    .InsuranceRecordList
        display: grid
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr))
        gap: 10px
        margin-bottom: 16px

    .InsuranceRecordOption
        min-height: 54px
        display: flex
        align-items: center
        gap: 10px
        padding: 10px 12px
        border: 1px solid var(--dash-line)
        border-radius: 12px
        cursor: pointer

        input
            width: 18px
            height: 18px
            flex: 0 0 auto

        span
            display: flex
            flex-direction: column
            gap: 3px
            font-size: 0.76rem
            color: var(--dash-text-2)

        strong
            color: var(--dash-text)
            font-size: 0.84rem

    .InsuranceReviewForm
        display: flex
        flex-direction: column
        gap: 16px

        fieldset
            margin: 0
            padding: 16px
            border: 1px solid var(--dash-line)
            border-radius: 12px

        legend
            padding: 0 8px
            font-weight: 600

    .InsuranceReviewNotice
        padding: 12px 14px
        border: 1px solid #c48b22
        border-radius: 10px
        background: rgba(196, 139, 34, 0.12)
        color: var(--dash-text)
        line-height: 1.45

    .InsuranceFieldGrid
        display: grid
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr))
        gap: 12px

    .InsuranceDiagnoses
        display: flex
        flex-direction: column
        gap: 12px

    .InsuranceDiagnosisRow
        display: grid
        grid-template-columns: minmax(100px, 0.6fr) minmax(220px, 2fr) minmax(140px, 1fr) auto
        align-items: end
        gap: 10px

    .InsuranceRemoveDiagnosis,
    .InsuranceAddDiagnosis
        min-height: 44px
        border: 1px solid var(--dash-line)
        border-radius: 10px
        background: transparent
        color: var(--dash-text)
        padding: 9px 12px
        cursor: pointer

        &:focus-visible
            outline: 2px solid var(--dash-accent)
            outline-offset: 2px

    .InsuranceAddDiagnosis
        margin-top: 12px

    .InsuranceReviewActions
        display: flex
        justify-content: flex-end

.InsurancePdfFrame
    width: 100%
    height: 100%
    border: 0

.InsurancePdfLoading
    width: 100%
    height: 100%
    display: grid
    place-items: center
    color: var(--dash-text-2)

@media (max-width: 760px)
    .InsuranceReports
        padding: 14px

        .InsuranceReportsHeader
            align-items: stretch
            flex-direction: column

        .InsuranceFormatSelect
            min-width: 0

        .InsuranceDiagnosisRow
            grid-template-columns: 1fr
