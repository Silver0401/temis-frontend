// ════════════════════════════════════════════════════════════════════════
// Expediente sin modelo 3D: nota expandida a la izquierda y línea de tiempo
// de notas de evolución a la derecha. Las tarjetas (`sec-card`) conservan
// sus estilos; aquí solo se define el contenedor y el timeline.
// ════════════════════════════════════════════════════════════════════════
.ClinicalHistoryContainer .GenericContainer .stage
    .note-detail
        // Ancla del overlay: la tarjeta a pantalla completa se posiciona
        // contra este panel, no contra la ventana.
        position: relative

        // Con una tarjeta a pantalla completa el título del panel estorba:
        // queda debajo y deja de capturar clicks (el botón de contraer cae
        // justo encima de él).
        &:has(.sec-card.is-fullscreen) .data-head
            z-index: 0
            pointer-events: none

        .data-scroll
            // `static` a propósito: así el bloque contenedor de la tarjeta a
            // pantalla completa es `.note-detail` y el overlay cubre también
            // el encabezado, sin quedar recortado por este scroll.
            position: static
            // La nota expandida apila tarjetas que crecen al abrirse: el grid
            // bento de alturas fijas las cortaría.
            display: flex
            flex-direction: column
            gap: 11px
            grid-template-columns: none
            grid-auto-rows: auto

            // Las tarjetas cuelgan de este wrapper, no del scroll: el `gap`
            // tiene que vivir aquí o quedan pegadas una encima de otra.
            .note-detail-body
                display: flex
                flex-direction: column
                gap: 16px

            .sec-card
                min-height: 0

            .note-copy-card .sec-body
                overflow: hidden

                // Textarea de solo lectura: conserva tal cual los espacios y
                // los saltos de línea que escribió el médico.
                .note-copy-text
                    width: 100%
                    min-height: 220px
                    height: 100%
                    padding: 0
                    resize: none
                    border: 0
                    outline: none
                    background: transparent
                    color: var(--dash-text-2)
                    font-family: "Poppins", sans-serif
                    font-size: 0.82rem
                    line-height: 1.65
                    white-space: pre-wrap
                    overflow-y: auto

                    &::-webkit-scrollbar
                        width: 8px
                    &::-webkit-scrollbar-thumb
                        background: var(--dash-line-hi)
                        border-radius: 4px

            // ── Tarjeta a pantalla completa sobre el panel izquierdo ──
            .sec-card.is-fullscreen
                position: absolute
                top: 0
                left: 0
                right: 0
                bottom: 0
                // Por encima del `.data-head` del panel (z-index 6): si el
                // título quedara arriba, taparía el botón de contraer y la
                // tarjeta expandida no se podría cerrar.
                z-index: 60
                margin: 0
                border-radius: 18px
                background: var(--dash-glass-solid)
                border-color: var(--dash-line-hi)
                backdrop-filter: blur(30px) saturate(160%)
                -webkit-backdrop-filter: blur(30px) saturate(160%)
                box-shadow: var(--dash-shadow)

                .sec-body
                    flex: 1
                    min-height: 0
                    overflow-y: auto

                    .ParcialDxDisplay
                        height: auto
                        overflow: visible

                    .note-copy-text
                        height: 100%

                .sec-exp
                    border-color: var(--dash-line-hi)
                    color: var(--dash-cyan)
                    transform: none

                    .i-expand
                        display: none
                    .i-compress
                        display: block

            .note-section
                .note-section-head
                    width: 100%

                    // El encabezado abre/cierra en línea; el botón de la
                    // esquina expande a pantalla completa, así que van
                    // separados y no anidados.
                    .note-section-toggle
                        flex: 1
                        min-width: 0
                        display: flex
                        align-items: center
                        gap: 10px
                        padding: 0
                        border: 0
                        background: transparent
                        color: inherit
                        cursor: pointer
                        text-align: left

                &.is-open
                    border-color: var(--dash-line-hi)

                &.is-open .sec-exp
                    color: var(--dash-cyan)
                    transform: rotate(45deg)

                .sec-body
                    overflow: visible

                    .ParcialDxDisplay
                        height: auto
                        overflow: visible

            .note-loading
                display: grid
                place-items: center
                min-height: 120px

    // ╔══ DERECHA · LÍNEA DE TIEMPO ══╗
    .notes-view
        .note-head
            align-items: flex-start
            text-align: left

            .note-total
                margin-top: 3px
                font-size: 0.66rem
                color: var(--dash-text-3)

        .note-empty
            padding: 30px
            color: var(--dash-text-3)
            text-align: center

        .notes-timeline
            position: relative
            flex: 1
            min-height: 0
            overflow-y: auto
            margin: 0
            padding: 14px 14px 14px 34px
            list-style: none
            display: flex
            flex-direction: column
            gap: 10px

            &::-webkit-scrollbar
                width: 9px
            &::-webkit-scrollbar-track
                background: transparent
            &::-webkit-scrollbar-thumb
                background: var(--dash-line)
                border-radius: 5px
                border: 2px solid transparent
                background-clip: content-box

            &::before
                content: ''
                position: absolute
                left: 20px
                top: 22px
                bottom: 18px
                width: 1px
                background: linear-gradient(var(--dash-cyan), var(--dash-line-hi))

            .timeline-entry
                position: relative
                transition: opacity 240ms ease

                &[data-muted="true"]
                    opacity: 0.62

                .timeline-dot
                    position: absolute
                    left: -19px
                    top: 20px
                    width: 10px
                    height: 10px
                    border: 2px solid var(--dash-card-bg-2)
                    border-radius: 50%
                    background: var(--dash-text-3)

                &[data-expanded="true"]
                    opacity: 1

                    .timeline-dot
                        background: var(--dash-cyan)
                        box-shadow: 0 0 10px var(--dash-cyan)

                    .timeline-card
                        border-color: var(--dash-cyan)
                        background: var(--dash-card-bg-2)

                .timeline-card
                    border: 1px solid var(--dash-line)
                    border-radius: 15px
                    background: var(--dash-card-bg)
                    overflow: hidden
                    transition: border-color 200ms ease, background 200ms ease

                    &:hover
                        border-color: var(--dash-line-hi)

                .timeline-summary
                    position: relative
                    width: 100%
                    padding: 13px 15px
                    display: grid
                    gap: 3px
                    color: inherit
                    border: 0
                    background: transparent
                    text-align: left
                    cursor: pointer

                    &:focus-visible
                        outline: 2px solid var(--dash-cyan)
                        outline-offset: 3px

                    .timeline-date
                        font-size: 0.62rem
                        color: var(--dash-text-3)

                    .timeline-title
                        font-family: "Poppins", sans-serif
                        font-size: 0.82rem
                        font-weight: 700
                        color: var(--dash-text)

                    .timeline-details
                        font-size: 0.66rem
                        color: var(--dash-text-2)

                    .timeline-chevron
                        position: absolute
                        top: 13px
                        right: 15px
                        color: var(--dash-text-3)
                        font-size: 0.9rem
                        transition: transform 260ms ease

                &[data-expanded="true"] .timeline-chevron
                    color: var(--dash-cyan)
                    transform: rotate(180deg)


