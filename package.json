{
  "name": "temis-frontend",
  "version": "1.0.8.8",
  "private": true,
  "scripts": {
    "dev": "concurrently \"env-cmd -f ./.env.dev next dev\" \"npm run stylus\" \"npm run mac-qr-dev\"",
    "prod": "concurrently \"env-cmd -f ./.env.prod next dev\" \"npm run stylus\" \"npm run mac-qr-dev\"",
    "local": "concurrently \"env-cmd -f ./.env.local next dev\" \"npm run stylus\" \"npm run mac-qr-dev\"",
    "build": "next build",
    "debug": "NODE_OPTIONS=\"--enable-source-maps\" next build",
    "start": "next start",
    "lint": "next lint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:record": "playwright codegen http://localhost:3000",
    "e2e:report": "playwright show-report",
    "stylus": "stylus -w src/styles/stylus --out src/styles/css/Index.css",
    "mac-qr-dev": "node ./bundler/getLinuxQrCode.js"
  },
  "dependencies": {
    "@feathersjs/authentication-client": "^5.0.32",
    "@feathersjs/rest-client": "^5.0.32",
    "@feathersjs/socketio-client": "^5.0.30",
    "@fullcalendar/core": "^6.1.18",
    "@fullcalendar/daygrid": "^6.1.18",
    "@fullcalendar/interaction": "^6.1.18",
    "@fullcalendar/list": "^6.1.18",
    "@fullcalendar/react": "^6.1.18",
    "@fullcalendar/timegrid": "^6.1.18",
    "@nivo/line": "^0.98.0",
    "@react-pdf/renderer": "^4.3.2",
    "@tanstack/react-query": "^5.52.1",
    "@types/animejs": "^3.1.12",
    "@types/react": "npm:types-react@rc",
    "@types/react-dom": "npm:types-react-dom@rc",
    "@visx/gradient": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/hierarchy": "^3.12.0",
    "@visx/legend": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "animejs": "^3.2.2",
    "axios": "^1.7.4",
    "bcryptjs": "^3.0.3",
    "motion": "^11.11.17",
    "next": "^14.2.7",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-camera-pro": "^1.4.0",
    "react-dom": "^18.3.1",
    "react-intersection-observer": "^9.16.0",
    "react-pdf": "^10.3.0",
    "react-qr-code": "^2.0.15",
    "react-responsive": "^10.0.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "socket.io-client": "^4.7.5",
    "sonner": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "env-cmd": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "os": "^0.1.2",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5"
  }
}
